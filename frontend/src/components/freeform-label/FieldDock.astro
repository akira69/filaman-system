---
import { designerIcon, type DesignerIconName } from '../../lib/freeform-label/icons'

const filamentFields = [
  ['{filament.name}', 'Name', 'labelDesigner.fieldName'],
  ['{filament.type}', 'Type', 'labelDesigner.fieldType'],
  ['{filament.manufacturer}', 'Manufacturer', 'labelDesigner.fieldManufacturer'],
  ['{filament.color_name}', 'Color', 'labelDesigner.fieldColor'],
  ['{filament.color_hex}', 'Hex', 'labelDesigner.fieldHex'],
]
const spoolFields = [
  ['{id}', 'ID', 'labelDesigner.fieldId'],
  ['{location}', 'Location', 'labelDesigner.fieldLocation'],
  ['{status}', 'Status', 'labelDesigner.fieldStatus'],
  ['{remaining_weight_g}', 'Remaining', 'labelDesigner.fieldRemaining'],
  ['{lot_number}', 'Lot', 'labelDesigner.fieldLot'],
]
const iconModifiers: Array<{ modifier: string; icon: DesignerIconName; label: string; i18n: string }> = [
  { modifier: 'caps', icon: 'uppercase', label: 'Uppercase', i18n: 'labelDesigner.modifierUppercase' },
  { modifier: 'inverse', icon: 'inverse', label: 'Inverse', i18n: 'labelDesigner.modifierInverse' },
  { modifier: 'colorInverse', icon: 'colorInverse', label: 'Filament color inverse', i18n: 'labelDesigner.modifierColorInverse' },
  { modifier: 'date', icon: 'date', label: 'Date only', i18n: 'labelDesigner.modifierDateOnly' },
]
---

<section id="freeform-field-dock" class="freeform-field-dock" aria-labelledby="freeform-fields-title">
  <div class="freeform-field-dock-heading">
    <h2 id="freeform-fields-title" data-i18n="labelDesigner.fieldsAndModifiers">Fields & modifiers</h2>
    <div class="freeform-modifiers" role="group" aria-label="Text modifiers" data-i18n-aria-label="labelDesigner.textModifiers">
      <button type="button" data-field-modifier="bold" aria-pressed="false" title="Bold" aria-label="Bold" data-i18n-title="labelDesigner.modifierBold" data-i18n-aria-label="labelDesigner.modifierBold"><strong>B</strong></button>
      <button type="button" data-field-modifier="italic" aria-pressed="false" title="Italic" aria-label="Italic" data-i18n-title="labelDesigner.modifierItalic" data-i18n-aria-label="labelDesigner.modifierItalic"><em>I</em></button>
      <button type="button" data-field-modifier="underline" aria-pressed="false" title="Underline" aria-label="Underline" data-i18n-title="labelDesigner.modifierUnderline" data-i18n-aria-label="labelDesigner.modifierUnderline"><u>U</u></button>
      {iconModifiers.map(item => <button type="button" data-field-modifier={item.modifier} aria-pressed="false" title={item.label} aria-label={item.label} data-i18n-title={item.i18n} data-i18n-aria-label={item.i18n} set:html={designerIcon(item.icon)} />)}
    </div>
  </div>
  <div class="freeform-field-tabs" role="tablist" aria-label="Field groups" data-i18n-aria-label="labelDesigner.fieldGroups">
    <button id="freeform-field-tab-filament" type="button" role="tab" aria-selected="true" aria-controls="freeform-field-panel-filament" tabindex="0" data-field-group-tab="filament" data-i18n="labelDesigner.filamentFields">Filament</button>
    <button id="freeform-field-tab-spool" type="button" role="tab" aria-selected="false" aria-controls="freeform-field-panel-spool" tabindex="-1" data-field-group-tab="spool" data-i18n="labelDesigner.spoolFields">Spool</button>
    <button id="freeform-field-tab-extra" type="button" role="tab" aria-selected="false" aria-controls="freeform-field-panel-extra" tabindex="-1" data-field-group-tab="extra" data-i18n="labelDesigner.extraFields">Custom / extra</button>
  </div>
  <div class="freeform-field-groups freeform-field-panel-frame">
    <div id="freeform-field-panel-filament" role="tabpanel" aria-labelledby="freeform-field-tab-filament" data-field-group="filament">{filamentFields.map(([token, label, i18n]) => <button class="freeform-token-chip" type="button" data-field-token={token} title={token} data-i18n={i18n}>{label}</button>)}</div>
    <div id="freeform-field-panel-spool" role="tabpanel" aria-labelledby="freeform-field-tab-spool" data-field-group="spool" hidden>{spoolFields.map(([token, label, i18n]) => <button class="freeform-token-chip" type="button" data-field-token={token} title={token} data-i18n={i18n}>{label}</button>)}</div>
    <div id="freeform-field-panel-extra" role="tabpanel" aria-labelledby="freeform-field-tab-extra" data-field-group="extra" hidden><div id="freeform-extra-fields"><span data-i18n="labelDesigner.noExtraFields">No custom fields available.</span></div></div>
  </div>
  <p id="freeform-field-hint" class="freeform-field-hint" data-i18n="labelDesigner.selectTextHint">Select a text element to insert at its caret. With another element selected, a new text box is created.</p>
</section>

<style>
  .freeform-field-dock { background: var(--bg-elevated); border-top: 1px solid var(--border); padding: 9px 12px; }
  .freeform-field-dock-heading { align-items: center; display: flex; gap: 10px; justify-content: space-between; }
  .freeform-field-dock h2 { color: var(--text-muted); font-size: 0.7rem; letter-spacing: 0.08em; margin: 0; text-transform: uppercase; }
  .freeform-modifiers, .freeform-field-tabs, .freeform-field-groups > div { display: flex; flex-wrap: wrap; gap: 4px; }
  .freeform-modifiers button, .freeform-field-tabs button { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 4px; color: var(--text); font-size: 0.72rem; min-height: 28px; padding: 4px 7px; }
  .freeform-modifiers button[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
  .freeform-field-tabs { align-items: flex-end; gap: 3px; margin: 7px 0 0; padding-left: 4px; position: relative; z-index: 1; }
  .freeform-field-tabs button { border-bottom-left-radius: 0; border-bottom-right-radius: 0; color: var(--text-muted); }
  .freeform-field-tabs button[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 16%, var(--bg-elevated)); border-color: var(--accent); border-bottom-color: var(--bg-elevated); box-shadow: inset 0 2px 0 var(--accent); color: var(--text); font-weight: 700; margin-bottom: -1px; }
  .freeform-field-panel-frame { background: color-mix(in srgb, var(--bg-soft) 55%, transparent); border: 1px solid var(--border); border-radius: 4px; max-height: 86px; overflow: auto; padding: 7px; }
  .freeform-token-chip { background: color-mix(in srgb, var(--accent) 12%, transparent); border: 1px solid var(--accent); border-radius: 4px; color: var(--accent); cursor: pointer; font-family: 'Space Mono', 'Courier New', monospace; font-size: 0.6rem; line-height: 1.4; min-height: 26px; padding: 2px 6px; white-space: nowrap; }
  .freeform-token-chip:hover { background: var(--accent); color: var(--btn-primary-text); }
  .freeform-field-hint { color: var(--text-muted); font-size: 0.68rem; margin: 6px 0 0; }
  .freeform-modifiers button :global(svg) { height: 16px; width: 16px; }
  .freeform-field-dock button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
