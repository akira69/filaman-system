---
import { designerIcon } from '../../lib/freeform-label/icons'
import ImageCropDialog from './ImageCropDialog.astro'

const alignmentOptions = [
  { value: 'left', label: 'Left', icon: 'alignLeft', i18n: 'labelDesigner.alignLeft' },
  { value: 'center', label: 'Center', icon: 'alignCenter', i18n: 'labelDesigner.alignCenter' },
  { value: 'right', label: 'Right', icon: 'alignRight', i18n: 'labelDesigner.alignRight' },
] as const

const verticalAlignmentOptions = [
  { value: 'top', label: 'Top', icon: 'alignTop', i18n: 'labelDesigner.alignTop' },
  { value: 'middle', label: 'Middle', icon: 'alignMiddle', i18n: 'labelDesigner.alignMiddle' },
  { value: 'bottom', label: 'Bottom', icon: 'alignBottom', i18n: 'labelDesigner.alignBottom' },
] as const
---

<aside id="freeform-element-inspector" class="freeform-element-inspector" aria-labelledby="freeform-inspector-title">
  <header>
    <div>
      <span class="freeform-kicker" data-i18n="labelDesigner.selectedElement">Selected element</span>
      <h2 id="freeform-inspector-title" data-i18n="labelDesigner.noSelection">No selection</h2>
    </div>
  </header>

  <div id="freeform-inspector-empty" class="freeform-inspector-empty" data-i18n="labelDesigner.selectElementHint">Select an element on the label to edit it.</div>
  <div id="freeform-inspector-fields" class="freeform-inspector-fields" hidden>
    <div class="freeform-geometry-grid">
      <label><span data-i18n="labelDesigner.xMm">X (mm)</span><input class="fm-input" type="number" step="0.1" data-element-prop="x" /></label>
      <label><span data-i18n="labelDesigner.yMm">Y (mm)</span><input class="fm-input" type="number" step="0.1" data-element-prop="y" /></label>
      <label><span data-i18n="labelDesigner.widthMm">Width (mm)</span><input class="fm-input" type="number" step="0.1" data-element-prop="w" /></label>
      <label><span data-i18n="labelDesigner.heightMm">Height (mm)</span><input class="fm-input" type="number" step="0.1" data-element-prop="h" /></label>
    </div>

    <div data-element-section="text" hidden>
      <div class="freeform-geometry-grid">
        <label><span data-i18n="labelDesigner.font">Font</span><select class="fm-input" data-element-prop="fontFamily"><option>Space Grotesk</option><option>Roboto Condensed</option><option>Fraunces</option><option>Space Mono</option></select></label>
        <label><span data-i18n="labelDesigner.fontSizeMm">Size (mm)</span><input class="fm-input" type="number" min="1" max="20" step="0.1" data-element-prop="fontSizeMm" /></label>
        <label><span data-i18n="labelDesigner.weight">Weight</span><select class="fm-input" data-element-prop="fontWeight"><option value="400">400</option><option value="500">500</option><option value="600">600</option><option value="700">700</option></select></label>
        <div class="freeform-alignment-field">
          <span id="freeform-alignment-label" data-i18n="labelDesigner.alignment">Alignment</span>
          <div class="freeform-alignment-buttons" role="group" aria-labelledby="freeform-alignment-label">
            {alignmentOptions.map(option => <button type="button" data-element-align={option.value} aria-label={option.label} title={option.label} data-i18n-aria-label={option.i18n} data-i18n-title={option.i18n} aria-pressed="false" disabled><Fragment set:html={designerIcon(option.icon)} /></button>)}
          </div>
        </div>
        <div class="freeform-alignment-field">
          <span id="freeform-vertical-alignment-label" data-i18n="labelDesigner.verticalAlignment">Vertical alignment</span>
          <div class="freeform-alignment-buttons" role="group" aria-labelledby="freeform-vertical-alignment-label">
            {verticalAlignmentOptions.map(option => <button type="button" data-element-vertical-align={option.value} aria-label={option.label} title={option.label} data-i18n-aria-label={option.i18n} data-i18n-title={option.i18n} aria-pressed="false" disabled><Fragment set:html={designerIcon(option.icon)} /></button>)}
          </div>
        </div>
        <label class="freeform-wrap-field"><input type="checkbox" data-element-prop="wrap" /><span data-i18n="labelDesigner.wordWrap">Word wrap</span></label>
      </div>
    </div>

    <div data-element-section="shape" hidden>
      <label class="freeform-field"><span data-i18n="labelDesigner.lineThicknessMm">Line thickness (mm)</span><input class="fm-input" type="number" min="0" max="10" step="0.1" data-element-prop="strokeWidthMm" /></label>
    </div>

    <div data-element-section="qr" hidden>
      <fieldset class="freeform-qr-center-picker">
        <legend data-i18n="labelDesigner.qrCenterLogo">Center logo</legend>
        <div class="freeform-qr-center-options">
          <label class="freeform-qr-center-option">
            <input type="radio" name="freeform-qr-center" value="colorLogo" data-element-prop="mode" />
            <span class="freeform-qr-center-card">
              <span class="freeform-qr-center-preview" aria-hidden="true"><img src="/logo-qr.png" alt="" width="56" height="32" /></span>
              <span data-i18n="labelDesigner.qrCenterColor">Color</span>
            </span>
          </label>
          <label class="freeform-qr-center-option">
            <input type="radio" name="freeform-qr-center" value="logo" data-element-prop="mode" />
            <span class="freeform-qr-center-card">
              <span class="freeform-qr-center-preview" aria-hidden="true"><svg viewBox="0 0 100 42"><text x="50" y="26" text-anchor="middle" fill="black" font-family="Space Grotesk, sans-serif" font-size="22" font-weight="700">FilaMan</text></svg></span>
              <span data-i18n="labelDesigner.qrCenterText">Text</span>
            </span>
          </label>
          <label class="freeform-qr-center-option">
            <input type="radio" name="freeform-qr-center" value="simple" data-element-prop="mode" />
            <span class="freeform-qr-center-card">
              <span class="freeform-qr-center-preview" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2"><path d="M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h3v3h3v3h-6zM12 3v3M12 9v3H3M6 12v3M12 15v6M15 12h6M18 9v3" /></svg></span>
              <span data-i18n="labelDesigner.qrCenterNone">None</span>
            </span>
          </label>
        </div>
      </fieldset>
      <div class="freeform-qr-readability">
        <p id="freeform-qr-readability-recommendation" data-i18n="labelDesigner.qrReadabilityUnavailable">300 DPI size guidance appears after the code is rendered.</p>
        <p id="freeform-qr-readability-warning" class="freeform-qr-readability-warning" role="status" hidden></p>
        <p id="freeform-qr-readability-note" class="freeform-qr-readability-note" data-i18n="labelDesigner.qrReadabilityNote">Keep 4 modules of white clear space around the code and make a test print. This advisory does not guarantee scanning.</p>
      </div>
    </div>

    <div data-element-section="image" hidden>
      <label class="freeform-field"><span data-i18n="labelDesigner.image">Image</span><select id="freeform-image-asset" class="fm-input" data-element-prop="assetId"></select></label>
      <div class="freeform-image-actions">
        <button id="freeform-image-crop" type="button" disabled><Fragment set:html={designerIcon('crop')} /><span data-i18n="labelDesigner.cropImage">Crop image</span></button>
        <button id="freeform-image-upload-trigger" type="button" data-i18n-title="labelDesigner.uploadImageHint" title="Upload a PNG, JPEG, or WebP image to the image library."><Fragment set:html={designerIcon('upload')} /><span data-i18n="labelDesigner.uploadImage">Upload image</span></button>
        <input id="freeform-image-upload" type="file" accept="image/png,image/jpeg,image/webp" hidden />
        <button id="freeform-image-delete" type="button" class="freeform-danger-action" aria-describedby="freeform-image-delete-help" data-i18n-title="labelDesigner.deleteImageHint" title="Delete the selected file from the image library. Images used by saved presets are protected. Use Delete in the top toolbar to remove only the box from this label."><Fragment set:html={designerIcon('delete')} /><span data-i18n="labelDesigner.deleteImageFromLibrary">Delete from library</span></button>
      </div>
      <p id="freeform-image-delete-help" class="visually-hidden" data-i18n="labelDesigner.deleteImageHint">Delete the selected file from the image library. Images used by saved presets are protected. Use Delete in the top toolbar to remove only the box from this label.</p>
      <p id="freeform-image-status" role="status" aria-live="polite"></p>
      <ImageCropDialog />
    </div>

    <section class="freeform-json-section" aria-labelledby="freeform-json-title">
      <div class="freeform-json-heading"><h3 id="freeform-json-title" data-i18n="labelDesigner.elementJson">Element JSON</h3><button id="freeform-json-expand" type="button" aria-expanded="false" aria-controls="freeform-element-json" data-i18n="labelDesigner.expand">Expand</button></div>
      <label for="freeform-element-json" class="visually-hidden" data-i18n="labelDesigner.elementJson">Element JSON</label>
      <textarea id="freeform-element-json" class="fm-input" rows="12" spellcheck="false" aria-describedby="freeform-json-error"></textarea>
      <p id="freeform-json-error" class="freeform-json-error" role="alert"></p>
      <div class="freeform-json-actions"><button id="freeform-json-revert" type="button" data-i18n="common.revert">Revert</button><button id="freeform-json-apply" type="button" class="preset-action-btn-primary" data-i18n="common.apply">Apply</button></div>
    </section>
  </div>
</aside>

<style>
  .freeform-element-inspector { align-self: stretch; background: var(--bg-elevated); border-left: 1px solid var(--border); min-width: 260px; overflow: auto; padding: 12px; width: min(320px, 28vw); }
  .freeform-element-inspector header, .freeform-json-heading, .freeform-json-actions, .freeform-image-actions { align-items: center; display: flex; gap: 8px; justify-content: space-between; }
  .freeform-element-inspector h2, .freeform-element-inspector h3 { margin: 0; }
  .freeform-element-inspector h2 { font-size: 0.9rem; }
  .freeform-element-inspector h3 { font-size: 0.76rem; text-transform: uppercase; }
  .freeform-kicker { color: var(--text-muted); font-size: 0.67rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .freeform-json-actions button, .freeform-json-heading button, .freeform-image-actions button { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 4px; color: var(--text); cursor: pointer; font-size: 0.72rem; padding: 5px 7px; }
  .freeform-image-actions { flex-wrap: wrap; justify-content: flex-start; margin-top: 12px; }
  .freeform-image-actions button { align-items: center; display: inline-flex; gap: 5px; max-width: 100%; text-align: left; }
  .freeform-image-actions :global(svg) { flex: 0 0 16px; height: 16px; width: 16px; }
  .freeform-image-actions button:disabled { cursor: default; opacity: 0.5; }
  .freeform-inspector-empty { color: var(--text-muted); font-size: 0.78rem; padding: 24px 0; }
  .freeform-inspector-fields, .freeform-field { display: grid; gap: 10px; }
  .freeform-geometry-grid { display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .freeform-geometry-grid label, .freeform-field { font-size: 0.72rem; }
  .freeform-alignment-field { font-size: 0.72rem; min-width: 0; }
  .freeform-alignment-buttons { display: flex; gap: 4px; margin-top: 4px; }
  .freeform-alignment-buttons button { align-items: center; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 4px; color: var(--text-muted); cursor: pointer; display: inline-flex; flex: 0 0 30px; height: 30px; justify-content: center; padding: 5px; width: 30px; }
  .freeform-alignment-buttons :global(svg) { height: 18px; width: 18px; }
  .freeform-alignment-buttons button:not(:disabled):hover { border-color: var(--text-muted); color: var(--text); }
  .freeform-alignment-buttons button[aria-pressed="true"] { background: color-mix(in srgb, var(--accent) 12%, var(--bg-soft)); border-color: var(--accent); color: var(--accent); }
  .freeform-alignment-buttons button:disabled { cursor: default; opacity: 0.5; }
  .freeform-wrap-field { align-items: center; display: flex; gap: 6px; }
  .freeform-wrap-field input { accent-color: var(--accent); margin: 0; }
  .freeform-qr-center-picker { border: 0; margin: 0; min-width: 0; padding: 0; }
  .freeform-qr-center-picker legend { font-size: 0.72rem; margin-bottom: 8px; padding: 0; }
  .freeform-qr-center-options { display: grid; gap: 6px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .freeform-qr-center-option { cursor: pointer; min-width: 0; position: relative; }
  .freeform-qr-center-option input { height: 1px; opacity: 0; position: absolute; width: 1px; }
  .freeform-qr-center-card { align-items: center; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 6px; color: var(--text-muted); display: flex; flex-direction: column; font-size: 0.72rem; gap: 6px; padding: 6px; }
  .freeform-qr-center-preview { align-items: center; background: white; border-radius: 3px; display: flex; height: 34px; justify-content: center; overflow: hidden; width: 100%; }
  .freeform-qr-center-preview img { height: auto; max-height: 30px; object-fit: contain; width: 100%; }
  .freeform-qr-center-preview svg { height: 30px; max-width: 100%; }
  .freeform-qr-center-option:hover .freeform-qr-center-card { border-color: var(--text-muted); }
  .freeform-qr-center-option input:checked + .freeform-qr-center-card { background: color-mix(in srgb, var(--accent) 12%, var(--bg-soft)); border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); color: var(--text); font-weight: 600; }
  .freeform-qr-center-option input:focus-visible + .freeform-qr-center-card { outline: 2px solid var(--accent); outline-offset: 3px; }
  .freeform-qr-center-option input:disabled + .freeform-qr-center-card { cursor: default; opacity: 0.5; }
  .freeform-qr-readability { color: var(--text-muted); font-size: 0.7rem; line-height: 1.4; margin-top: 10px; }
  .freeform-qr-readability p { margin: 4px 0 0; }
  .freeform-qr-readability-warning { background: color-mix(in srgb, #f59e0b 14%, transparent); border-left: 3px solid #f59e0b; color: var(--text); padding: 5px 7px; }
  .freeform-qr-readability-note { font-size: 0.64rem; }
  .freeform-json-section { border-top: 1px solid var(--border); margin-top: 12px; padding-top: 12px; }
  #freeform-element-json { font-family: 'Space Mono', monospace; min-height: 240px; resize: vertical; width: 100%; }
  .freeform-json-section.is-expanded { background: var(--bg-elevated); inset: 12px; padding: 16px; position: fixed; z-index: 1000; }
  .freeform-json-section.is-expanded #freeform-element-json { height: calc(100vh - 150px); }
  .freeform-json-error { color: var(--label-danger, #ff8a80); font-size: 0.72rem; min-height: 1.2em; }
  .visually-hidden { border: 0; clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0; position: absolute; white-space: nowrap; width: 1px; }
  .freeform-element-inspector :is(button, select, input, textarea):focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .freeform-danger-action:not(:disabled):hover, .freeform-danger-action:focus-visible { border-color: var(--label-danger, #ff8a80); color: var(--label-danger, #ff8a80); }
</style>
