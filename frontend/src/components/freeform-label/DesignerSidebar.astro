<div id="tab-panel-designer-v2" class="settings-section freeform-designer-sidebar" hidden>
  <section class="freeform-sidebar-section" aria-labelledby="freeform-presets-heading">
    <h2 id="freeform-presets-heading" data-i18n="labelDesigner.presets">Label presets</h2>
    <label class="fm-label" for="freeform-preset-list" data-i18n="labelDesigner.savedPresets">Saved presets</label>
    <div class="preset-control-row">
      <select id="freeform-preset-list" class="fm-select preset-select"></select>
      <button id="freeform-preset-load" class="preset-action-btn" type="button" data-i18n="common.load">Load</button>
      <button id="freeform-preset-delete" class="preset-action-btn preset-action-btn-danger" type="button" data-i18n="common.delete">Delete</button>
    </div>
    <label class="fm-label" for="freeform-preset-name" data-i18n="labelDesigner.presetName">Preset name</label>
    <div class="preset-control-row">
      <input id="freeform-preset-name" class="fm-input preset-name-input" maxlength="120" placeholder="My label" data-i18n-placeholder="labelDesigner.presetNamePlaceholder" />
      <button id="freeform-preset-save" class="preset-action-btn preset-action-btn-primary" type="button" data-i18n="labelDesigner.saveNew">Save as New</button>
    </div>
    <p id="freeform-preset-status" class="freeform-control-status" role="status" aria-live="polite"></p>
  </section>

  <section class="freeform-sidebar-section" aria-labelledby="freeform-label-heading">
    <h2 id="freeform-label-heading" data-i18n="labelDesigner.labelGeometry">Label geometry</h2>
    <div class="freeform-dimension-grid">
      <label><span data-i18n="labelDesigner.widthMm">Width (mm)</span><input id="freeform-label-width" class="fm-input" type="number" min="20" max="300" step="0.5" /></label>
      <label><span data-i18n="labelDesigner.heightMm">Height (mm)</span><input id="freeform-label-height" class="fm-input" type="number" min="10" max="200" step="0.5" /></label>
      <label><span data-i18n="labelDesigner.marginMm">Margin (mm)</span><input id="freeform-label-margin" class="fm-input" type="number" min="0" max="6" step="0.5" /></label>
    </div>
    <label class="fm-checkbox-group"><input id="freeform-label-border" type="checkbox" /><span data-i18n="labelDesigner.printBorder">Print border</span></label>
  </section>

  <section class="freeform-sidebar-section" aria-labelledby="freeform-selection-heading">
    <h2 id="freeform-selection-heading" data-i18n="labelDesigner.selection">Selection</h2>
    <p id="freeform-selection-summary" class="freeform-selection-summary"></p>
  </section>
</div>

<style>
  .freeform-designer-sidebar { gap: 10px; }
  .freeform-sidebar-section { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; }
  .freeform-sidebar-section h2 { color: var(--text-muted); font-size: 0.72rem; letter-spacing: 0.08em; margin: 0 0 10px; text-transform: uppercase; }
  .freeform-dimension-grid { display: grid; gap: 8px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .freeform-dimension-grid label { display: grid; font-size: 0.75rem; gap: 4px; }
  .freeform-control-status, .freeform-selection-summary { color: var(--text-muted); font-size: 0.75rem; margin: 8px 0 0; min-height: 1.2em; }
</style>
