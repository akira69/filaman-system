---
import Layout from '../../layouts/Layout.astro'
import AdminHeader from '../../components/AdminHeader.astro'
import FormDialog from '../../components/FormDialog.astro'
---

<Layout title="FilaMan - Plugins">
  <style>
    .plugin-toolbar-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .plugin-toolbar-actions .fm-btn, #install-submit, :global(.plugin-actions .btn-update) {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    }
    .plugin-toolbar-actions .fm-btn[hidden] { display: none; }
    .plugin-toolbar-actions svg, #install-submit svg, :global(.plugin-actions .btn-update svg) { flex: none; }
    .plugin-toolbar-actions .fm-btn:disabled { opacity: .55; cursor: not-allowed; }
    .plugin-table { width: 100%; }
    @container detail-page (width > 48rem) {
      .plugin-table :global(td:first-child) { min-width: 180px; }
      .plugin-table :global(:is(th, td):not(:first-child)) { width: 1%; }
      .plugin-table :global(:is(th, td):not(:first-child, .plugin-controls)) { white-space: nowrap; }
      .plugin-table :global(.plugin-actions) { width: max-content; margin-inline-start: auto; }
      .plugin-table :global(.plugin-update-message:not(:empty)) { width: 13rem; }
    }
    :global(.plugin-actions) { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
    :global(.plugin-actions > *) { flex-shrink: 0; }
    :global(.plugin-description) { color: var(--text-muted); font-size: .8rem; line-height: 1.5; margin: 4px 0 0; }
    .plugin-table :global(.plugin-description-toggle),
    .plugin-table :global(.plugin-mobile-label) { display: none; }
    :global(.plugin-version) { font: .85rem monospace; }
    :global(.plugin-type span) {
      display: inline-block; padding: 2px 8px; border-radius: 999px;
      font-size: .75rem; font-weight: 600; background: var(--bg-soft); color: var(--text-muted);
    }
    :global(.plugin-author) { color: var(--text-muted); }
    :global(.plugin-state) { display: flex; align-items: center; }
    :global(.plugin-state .fm-toggle:has(:focus-visible)) { outline: 2px solid var(--accent); outline-offset: 2px; }
    :global(.plugin-actions .btn-update) { font-size: .8rem; padding: 4px 10px; white-space: normal; overflow-wrap: anywhere; }
    :global(.plugin-update-message:not(:empty)) { margin-top: 8px; min-width: 0; overflow-wrap: anywhere; }
    :global(.plugin-update-message:empty) { padding: 0; border: 0; }
    :global(.plugin-detail-row) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); align-items: start; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--border); }
    :global(.plugin-detail-value) { text-align: right; overflow-wrap: anywhere; }
    :global(.plugin-schema) { margin-top: 8px; background: var(--bg-soft); border-radius: var(--radius-sm); padding: 12px; font-size: .8rem; white-space: pre-wrap; overflow-wrap: anywhere; }
    .plugin-message:not(:empty) { margin-bottom: 16px; }
    .plugin-drop-zone { display: block; border: 2px dashed var(--border); border-radius: var(--radius-sm); padding: 20px; text-align: center; cursor: pointer; }
    .plugin-drop-zone:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    :global(#install-modal [hidden]) { display: none; }
    :global(#install-modal .fm-form-dialog-header) { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
    :global(#install-modal .fm-header-actions) { display: contents; }
    .plugin-install-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--inline-gap); }
    .plugin-install-feedback { grid-column: 1 / -1; display: grid; gap: 8px; overflow-wrap: anywhere; }
    .plugin-install-feedback:not(:has(> :not([hidden]))) { display: none; }
    @media (min-width: 641px) {
      :global(#install-modal.catalog-dialog) { width: min(58rem, calc(100vw - 32px)); }
    }
    :global(#install-modal.catalog-dialog h2) { font-size: 1.08rem; }
    :global(body:has(.plugin-admin) #fm-confirm-overlay.open) { transition: none; }
    :global(body:has(.plugin-admin) #fm-confirm-overlay .fm-modal) {
      max-height: calc(100dvh - 32px); overflow: auto; overflow-wrap: anywhere; transform: none; transition: none;
    }
    :global(body:has(.plugin-admin) #fm-confirm-overlay .fm-modal-actions) { flex-wrap: wrap; }
    :global(body:has(.plugin-admin) #fm-confirm-message) { white-space: pre-line; }
    .catalog-intro, #catalog-status { margin: 0; }
    #catalog-status:empty { position: absolute; }
    #catalog-retry { justify-self: start; }
    #error-details { max-height: min(8rem, 30dvh); overflow: auto; white-space: pre-wrap; }
    .catalog-tools { display: grid; gap: 12px; }
    .catalog-tools :is(input, select) { width: 100%; margin-top: 6px; }
    @media (min-width: 641px) {
      .catalog-tools { grid-template-columns: minmax(0, 1fr) 12rem; }
    }
    .catalog-list {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
      gap: 12px; list-style: none; margin: 0; padding: 0;
    }
    .catalog-list:empty { display: none; }
    .catalog-list :global(.catalog-card) {
      display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 16px;
      border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-soft);
      overflow-wrap: anywhere;
    }
    .catalog-list :global(.catalog-heading) { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px; }
    .catalog-list :global(.catalog-heading > div) { flex: 1; }
    .catalog-list :global(.catalog-icon) {
      display: grid; place-items: center; flex: 0 0 36px; height: 36px;
      border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg-elevated);
    }
    .catalog-list :global(.catalog-icon .fm-plugin-icon) { color: var(--accent); }
    .catalog-list :global(h3) { font-size: 1rem; line-height: 1.3; margin: 0; }
    .catalog-list :global(p) { margin: 0; }
    .catalog-list :global(.catalog-description) { color: var(--text-muted); font-size: .875rem; line-height: 1.5; }
    .catalog-list :global(.catalog-version-info) { display: grid; justify-items: end; gap: 3px; margin-inline-start: auto; }
    .catalog-list :global(.catalog-version) {
      padding: 3px 7px; border-radius: 999px; background: var(--bg-elevated);
      color: var(--text); font-size: .75rem; font-variant-numeric: tabular-nums; white-space: nowrap;
    }
    .catalog-list :global(.catalog-version-outdated) {
      background: var(--warning-bg); color: var(--warning-text); box-shadow: inset 0 0 0 1px var(--warning-border);
    }
    .catalog-list :global(.catalog-version-label) { color: var(--text-muted); font-size: .75rem; }
    .catalog-list :global(.catalog-footer) { display: grid; gap: 8px; margin-top: auto; }
    .catalog-list :global(.catalog-footer .fm-btn) {
      display: inline-flex; align-items: center; gap: 6px; justify-self: end; padding: 6px 12px; font-size: .8rem;
    }
    .catalog-list :global(.catalog-footer .fm-btn svg) { flex-shrink: 0; }
    .catalog-list :global(.catalog-publisher) { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
    .catalog-submit { color: var(--accent); font-size: .85rem; }
    .toggle-spinner { display: none; width: 16px; height: 16px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: toggle-spin .6s linear infinite; margin-left: 8px; }
    .toggle-spinner.visible { display: inline-block; }
    @keyframes toggle-spin { to { transform: rotate(360deg); } }

    @container detail-page (max-width: 48rem) {
      .plugin-list { padding: 0; border: 0; background: transparent; box-shadow: none; overflow: visible; }
      .plugin-table, .plugin-table :global(tbody) { display: block; }
      .plugin-table thead {
        display: block; position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
      }
      .plugin-table :global(tbody) { display: grid; gap: 12px; }
      .plugin-table :global(tbody > tr) {
        display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 2px 8px;
        padding: 14px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-elevated);
      }
      .plugin-table :global(tbody > tr:hover) { background: var(--bg-elevated); }
      .plugin-table :global(td) { width: auto; padding: 0; border: 0; }
      .plugin-table :global(td[colspan], .plugin-identity, .plugin-controls) { grid-column: 1 / -1; }
      .plugin-table :global(.plugin-author) { display: none; }
      .plugin-table :global(.fm-plugin-name) { font-size: 1rem; }
      .plugin-table :global(.plugin-description-wrap) {
        display: grid; grid-template-columns: minmax(0, 1fr) 44px; align-items: start; gap: 4px;
      }
      .plugin-table :global(.plugin-description-wrap:has([aria-expanded="false"]) .plugin-description) {
        display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
      }
      .plugin-table :global(.plugin-description-toggle:not([hidden])) {
        display: inline-flex; width: 44px; height: 44px;
      }
      .plugin-table :global(.plugin-description-toggle[aria-expanded="true"] svg) { transform: rotate(180deg); }
      .plugin-table :global(.plugin-status) { justify-self: end; }
      .plugin-table :global(.plugin-state) { gap: 6px; position: relative; }
      .plugin-table :global(.plugin-state .fm-toggle) { width: 44px; height: 44px; }
      .plugin-table :global(.plugin-state .fm-toggle-slider) { inset: 11px 2px; }
      .plugin-table :global(.plugin-state .toggle-spinner) { position: absolute; right: 14px; margin: 0; pointer-events: none; }
      .plugin-table :global(.plugin-mobile-label) { display: inline; color: var(--text-muted); font-size: .8rem; }
      .plugin-table :global(.plugin-controls) { padding-top: 4px; }
      .plugin-table :global(.plugin-actions) {
        display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 8px;
        border-top: 1px solid var(--border); padding-top: 8px;
      }
      .plugin-table :global(.plugin-actions .btn-update) { flex: 1 0 100%; min-height: 44px; font-size: .85rem; }
      .plugin-table :global(.plugin-actions .fm-row-action) { width: auto; min-width: 44px; height: 44px; gap: 6px; padding: 0 8px; }
      .plugin-table :global(.plugin-actions .btn-delete) { margin-inline-start: auto; }
    }

    @media (max-width: 640px) {
      .plugin-admin :global(.fm-admin-toolbar) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
      .plugin-admin :global(.fm-list-controls) { display: block; }
      .plugin-toolbar-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .plugin-toolbar-actions .fm-btn { min-height: 44px; white-space: normal; overflow-wrap: anywhere; }
      #btn-browse-plugins:has(+ #btn-update-all[hidden]) { grid-column: 1 / -1; }
      .catalog-list :global(.catalog-footer .fm-btn) { justify-content: center; justify-self: stretch; min-height: 44px; }
      .catalog-tools :is(input, select), .plugin-install-actions .fm-btn, #catalog-retry,
      :global(#detail-close), :global(body:has(.plugin-admin) #fm-confirm-overlay .fm-btn) { min-height: 44px; }
      .catalog-tools input { font-size: 1rem; }
      :global(#install-modal .fm-form-dialog-header) { overflow-wrap: anywhere; }
      :global(body:has(.plugin-admin) #fm-confirm-overlay .fm-modal) { padding: 20px; }
      :global(body:has(.plugin-admin) #fm-confirm-overlay .fm-modal-actions .fm-btn) {
        flex: 1 1 auto; padding-inline: 12px; white-space: normal;
      }
    }
  </style>
  <div class="fm-admin-page plugin-admin">
  <AdminHeader titleKey="admin.systemPlugins" title="Plugins">
    <div class="plugin-toolbar-actions">
      <button type="button" id="btn-check-updates" class="fm-btn fm-btn-outline">
        <svg width="16" height="16" aria-hidden="true"><use href="/icons.svg?v=2#icon-change-status" /></svg>
        <span data-i18n="admin.pluginCheckUpdates">Check for Updates</span>
      </button>
      <button type="button" id="btn-install" class="fm-btn fm-btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 16v5h16v-5" /></svg>
        <span data-i18n="admin.pluginUploadZip">Upload ZIP</span>
      </button>
      <button type="button" id="btn-browse-plugins" class="fm-btn fm-btn-primary">
        <svg width="16" height="16" aria-hidden="true"><use href="/icons.svg?v=2#icon-plugin" /></svg>
        <span data-i18n="admin.pluginBrowse">Browse Plugins</span>
      </button>
      <button type="button" id="btn-update-all" class="fm-btn fm-btn-primary" hidden>
        <svg width="16" height="16" aria-hidden="true"><use href="/icons.svg?v=2#icon-change-status" /></svg>
        <span data-i18n="admin.pluginUpdateAll">Update All</span>
      </button>
    </div>
  </AdminHeader>
  <div id="plugin-message" class="plugin-message" role="status"></div>
  <!-- Plugin-Liste -->
  <div class="fm-card plugin-list">
    <table class="fm-table fm-admin-table plugin-table" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col" data-i18n="common.name">Name</th>
          <th role="columnheader" scope="col" data-i18n="admin.pluginVersion">Version</th>
          <th role="columnheader" scope="col" data-i18n="admin.pluginType">Type</th>
          <th role="columnheader" scope="col" data-i18n="admin.pluginAuthor">Author</th>
          <th role="columnheader" scope="col" data-i18n="common.status">Status</th>
          <th role="columnheader" scope="col" style="text-align: right;" data-i18n="common.actions">Actions</th>
        </tr>
      </thead>
      <tbody id="plugins-table" role="rowgroup">
        <tr role="row">
          <td role="cell" colspan="6" style="text-align: center; color: var(--text-muted);" data-i18n="common.loading">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <!-- Install Modal -->
  <FormDialog id="install-modal" titleId="install-title" titleKey="admin.installPlugin" title="Install Plugin" wide>
    <Fragment slot="actions">
      <div class="plugin-install-actions">
        <button type="submit" form="install-form" id="install-submit" class="fm-btn fm-btn-primary" disabled>
          <svg width="16" height="16" aria-hidden="true"><use href="/icons.svg?v=2#icon-plugin" /></svg>
          <span data-i18n="admin.installPlugin">Install Plugin</span>
        </button>
        <button type="button" id="install-cancel" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.cancel">Cancel</button>
      </div>
      <span id="catalog-progress" class="fm-sr-only" role="status"></span>
      <div class="plugin-install-feedback">
        <div id="validation-details" class="fm-alert-success" role="status" hidden></div>
        <div id="error-details" class="fm-alert-error" role="alert" tabindex="0" hidden></div>
        <p id="upload-progress" class="fm-field-hint" style="margin: 0" role="status" data-i18n="admin.pluginInstalling" hidden>Installing…</p>
      </div>
    </Fragment>
      <form id="install-form" class="fm-compact-form">
        <div id="catalog-browser" class="fm-compact-form" hidden>
          <p class="catalog-intro fm-field-hint" data-i18n="admin.pluginBrowseIntro">Discover printer drivers and integrations that extend FilaMan.</p>
          <search class="catalog-tools">
            <div>
              <label for="catalog-search" class="fm-label" data-i18n="admin.pluginSearch">Search plugins</label>
              <input id="catalog-search" class="fm-input" type="search" />
            </div>
            <div>
              <label for="catalog-filter" class="fm-label" data-i18n="common.status">Status</label>
              <select id="catalog-filter" class="fm-select">
                <option value="all" data-i18n="admin.pluginFilterAll">All plugins</option>
                <option value="installed" data-i18n="admin.pluginFilterInstalled">Installed</option>
                <option value="uninstalled" data-i18n="admin.pluginFilterUninstalled">Not installed</option>
                <option value="updates" data-i18n="admin.pluginFilterUpdates">Updates available</option>
              </select>
            </div>
          </search>
          <p id="catalog-status" class="fm-field-hint" role="status"></p>
          <button id="catalog-retry" type="button" class="fm-btn fm-btn-outline" data-i18n="common.retry" hidden>Retry</button>
          <ul id="catalog-list" class="catalog-list"></ul>
          <div><a class="catalog-submit" href="https://github.com/Fire-Devils/filaman-system/blob/main/plugin-catalog/README.md#submit-a-plugin" target="_blank" rel="noopener noreferrer" data-i18n="admin.pluginSubmit">Submit a plugin</a></div>
        </div>

        <div id="plugin-zip-upload">
          <label for="file-input" class="fm-label" data-i18n="admin.pluginZipFile">Plugin ZIP File</label>
          <div id="drop-zone" class="plugin-drop-zone" role="button" tabindex="0" aria-labelledby="plugin-file-hint">
            <p id="plugin-file-hint" class="fm-field-hint" data-i18n="admin.pluginDropHint">Drag & Drop ZIP file here or click to select</p>
            <p id="file-name" style="margin: 8px 0 0; font-weight: 600; color: var(--text); display: none;"></p>
            <input type="file" id="file-input" accept=".zip,application/zip" style="display: none;" />
          </div>
        </div>
        
      </form>
  </FormDialog>
  
  <FormDialog id="detail-modal" titleId="detail-title" titleKey="admin.pluginDetails" title="Plugin Details">
    <Fragment slot="actions"><button type="button" id="detail-close" data-dialog-close class="fm-btn fm-btn-outline" data-i18n="common.close">Close</button></Fragment>
    <div id="detail-content" class="fm-compact-form"></div>
  </FormDialog>
  </div>

  <script>
    import { t, initI18n } from '../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../lib/abort'
    import { navHrefFor } from '../../lib/plugin-nav'
    import { createPluginIcon } from '../../lib/plugin-icon'
    import { ApiError, api, request } from '../../lib/api'
    import { bindFormDialog } from '../../lib/form-dialog'
    import { escapeHtml } from '../../lib/extra-fields'
    import { tableAction } from '../../lib/table-actions'
    await initI18n()

    interface Plugin {
      plugin_key: string; name: string; version: string; plugin_type: string; is_active: boolean
      description?: string | null; author?: string | null; installed_by?: number | null; installed_at: string
      page_url?: string | null; driver_key?: string | null; homepage?: string | null; license?: string | null
      icon_url?: string | null
      config_schema?: Record<string, unknown> | null
    }
    interface RegistryPlugin {
      plugin_key: string; name: string; version: string; description: string; publisher: string
      repository_url: string; min_filaman_version: string; is_compatible: boolean; release_id: string
      update_available: boolean; is_installed: boolean; requires_newer_zip: boolean; installed_version?: string | null
      icon_url?: string | null
    }
    interface InstallResult { plugin: { plugin_key: string; name: string; version: string }; message: string }
    const fm = window as unknown as { __fmConfirm: (message: string, options?: { title?: string; okLabel?: string; isDanger?: boolean }) => Promise<boolean> }
    let plugins: Plugin[] = []
    let selectedFile: File | null = null
    let availablePlugins: RegistryPlugin[] = []
    let updateMap = new Map<string, RegistryPlugin>()
    let updateRequest = 0
    let updating = false
    let pendingUpdate: string | null = null
    const updateAllButton = document.querySelector<HTMLButtonElement>('#btn-update-all')!
    const checkUpdatesButton = document.querySelector<HTMLButtonElement>('#btn-check-updates')!
    const updateMessages = new Map<string, { text: string; error: boolean }>()
    const descriptionObserver = new ResizeObserver(entries => {
      for (const { target } of entries) {
        const toggle = target.parentElement!.querySelector<HTMLButtonElement>('.plugin-description-toggle')!
        if (toggle.getAttribute('aria-expanded') === 'false') {
          toggle.hidden = target.scrollHeight <= target.clientHeight
        }
      }
    })
    
    let installing = false
    const installModal = document.getElementById('install-modal') as HTMLDialogElement
    const installDialog = bindFormDialog(installModal, { canClose: () => !installing })
    const detailDialog = bindFormDialog(document.getElementById('detail-modal') as HTMLDialogElement)
    function showMessage(message: string, error = false) {
      const host = document.getElementById('plugin-message')!
      host.className = `plugin-message ${message ? (error ? 'fm-alert-error' : 'fm-alert-success') : ''}`
      host.setAttribute('role', error ? 'alert' : 'status')
      host.textContent = message
    }

    // ----------------------------------------------------------------
    //  Plugin-Liste laden und rendern
    // ----------------------------------------------------------------
    
    async function loadPlugins() {
      try {
        plugins = await api.get<Plugin[]>('/admin/system/plugins')
        renderPlugins()
      } catch (error) {
        if (isAbortError(error)) return
        console.error('Failed to load plugins:', error)
        const tbody = document.getElementById('plugins-table')!
        tbody.innerHTML = `<tr role="row"><td role="cell" colspan="6" style="text-align: center; color: var(--error-text);">${escapeHtml(t('admin.pluginFailedLoad'))}</td></tr>`
      }
    }
    
    function renderPlugins() {
      const tbody = document.getElementById('plugins-table')!
      descriptionObserver.disconnect()
      const expanded = new Set([...tbody.querySelectorAll('[aria-expanded="true"][aria-controls]')].map(button => button.getAttribute('aria-controls')))
      
      if (plugins.length === 0) {
        tbody.innerHTML = `<tr role="row"><td role="cell" colspan="6" style="text-align: center; color: var(--text-muted);">${escapeHtml(t('admin.noPlugins'))}</td></tr>`
        return
      }
      
      const typeLabels: Record<string, string> = {
        driver: t('admin.pluginTypeDriver'),
        import: t('admin.pluginTypeImport'),
        integration: t('admin.pluginTypeIntegration'),
      }
      
      tbody.innerHTML = plugins.map(p => {
        const update = updateMap.get(p.plugin_key)
        const feedback = updateMessages.get(p.plugin_key)
        const descriptionId = `plugin-description-${p.plugin_key}`
        const openLabel = escapeHtml(`${t('common.open')} ${p.name}`)
        const nameHtml = p.page_url
          ? `<a href="${escapeHtml(navHrefFor(p.page_url))}" style="color: var(--accent); text-decoration: none; font-weight: 600;">${escapeHtml(p.name)}</a>`
          : `<span style="font-weight: 600;">${escapeHtml(p.name)}</span>`
        
        return `
        <tr role="row">
          <td role="cell" class="plugin-identity">
            <div class="fm-plugin-name"><span data-plugin-icon="${escapeHtml(p.plugin_key)}"></span>${nameHtml}</div>
            ${p.description ? `<div class="plugin-description-wrap">
              <p id="${escapeHtml(descriptionId)}" class="plugin-description">${escapeHtml(p.description)}</p>
              <button type="button" class="plugin-description-toggle fm-row-action" aria-label="${escapeHtml(t('admin.pluginDescription'))}" aria-expanded="${expanded.has(descriptionId)}" aria-controls="${escapeHtml(descriptionId)}">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>` : ''}
          </td>
          <td role="cell" class="plugin-version">${escapeHtml(p.version)}</td>
          <td role="cell" class="plugin-type">
            <span>${escapeHtml(typeLabels[p.plugin_type] || p.plugin_type)}</span>
          </td>
          <td role="cell" class="plugin-author">${escapeHtml(p.author || '-')}</td>
          <td role="cell" class="plugin-status">
            <div class="plugin-state">
              <span class="plugin-mobile-label" aria-hidden="true">${escapeHtml(t(p.is_active ? 'common.active' : 'common.inactive'))}</span>
              <label class="fm-toggle" title="${escapeHtml(p.is_active ? t('admin.pluginDeactivate') : t('admin.pluginActivate'))}">
                <input type="checkbox" class="toggle-active" aria-label="${escapeHtml(p.name)}: ${escapeHtml(t('common.status'))}" data-key="${escapeHtml(p.plugin_key)}" ${p.is_active ? 'checked' : ''} />
                <span class="fm-toggle-slider"></span>
              </label>
              <span class="toggle-spinner" data-spinner-key="${escapeHtml(p.plugin_key)}"></span>
            </div>
          </td>
          <td role="cell" class="plugin-controls">
            <div class="plugin-actions">
            ${update ? `<button type="button" data-key="${escapeHtml(p.plugin_key)}" class="btn-update fm-btn fm-btn-primary" aria-live="polite" ${updating ? 'disabled' : ''}><svg width="16" height="16" aria-hidden="true"><use href="/icons.svg?v=2#icon-change-status"></use></svg><span>${escapeHtml(pendingUpdate === p.plugin_key ? t('admin.pluginUpdating') : updateLabel(update))}</span></button>` : ''}
            <button type="button" data-key="${escapeHtml(p.plugin_key)}" class="btn-detail fm-row-action" aria-label="${escapeHtml(t('admin.pluginDetails'))}" title="${escapeHtml(t('admin.pluginDetails'))}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v1"/></svg><span class="plugin-mobile-label">${escapeHtml(t('admin.pluginDetails'))}</span></button>
            ${p.page_url ? `<a href="${escapeHtml(navHrefFor(p.page_url))}" class="fm-row-action" aria-label="${openLabel}" title="${openLabel}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg><span class="plugin-mobile-label">${escapeHtml(t('common.open'))}</span></a>` : ''}
            ${p.installed_by != null ? tableAction('delete', { key: p.plugin_key, name: p.name }, { title: t('admin.uninstallPlugin') }) : ''}
            </div>
            <div data-update-message="${escapeHtml(p.plugin_key)}" class="plugin-update-message${feedback ? (feedback.error ? ' fm-alert-error' : ' fm-alert-success') : ''}" role="${feedback?.error ? 'alert' : 'status'}">${escapeHtml(feedback?.text ?? '')}</div>
          </td>
        </tr>
      `}).join('')

      tbody.querySelectorAll<HTMLElement>('[data-plugin-icon]').forEach(host => {
        const plugin = plugins.find(p => p.plugin_key === host.dataset.pluginIcon)
        host.replaceWith(createPluginIcon(plugin?.icon_url))
      })
      tbody.querySelectorAll('.plugin-description').forEach(description => descriptionObserver.observe(description))
      tbody.querySelectorAll('.plugin-description-toggle').forEach(button => {
        button.addEventListener('click', () => {
          button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'))
        })
      })
      
      // Detail-Buttons
      document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const key = (e.currentTarget as HTMLButtonElement).dataset.key!
          showPluginDetails(key)
        })
      })
      
      // Update-Buttons
      tbody.querySelectorAll<HTMLButtonElement>('.btn-update').forEach(button => {
        button.addEventListener('click', () => {
          const release = updateMap.get(button.dataset.key!)
          if (release) void runUpdates([release], button)
        })
      })

      // Uninstall-Buttons
      document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const key = (e.currentTarget as HTMLButtonElement).dataset.key!
          const name = (e.currentTarget as HTMLButtonElement).dataset.name!
          
          const msg = t('admin.confirmUninstall').replace('{name}', name)
          if (!(await fm.__fmConfirm(msg))) return
          
          // Ask whether to also delete plugin data
          const deleteData = await fm.__fmConfirm(t('admin.confirmUninstallDeleteData'), { title: t('admin.uninstallPlugin'), okLabel: t('common.yes') || 'Yes', isDanger: false })
          const qs = deleteData ? '?delete_data=true' : ''
          
          try {
            await api.delete(`/admin/system/plugins/${key}${qs}`)
            updateMessages.delete(key)
            invalidateUpdate(key)
            loadPlugins()
          } catch (err) {
            if (isAbortError(err)) return
            showMessage(err instanceof Error ? err.message : t('admin.pluginUninstallFailed'), true)
          }
        })
      })
      
      // Toggle active/inactive
      document.querySelectorAll('.toggle-active').forEach(input => {
        input.addEventListener('change', async (e) => {
          const checkbox = e.currentTarget as HTMLInputElement
          const key = checkbox.dataset.key!
          const newState = checkbox.checked
          const spinner = document.querySelector(`.toggle-spinner[data-spinner-key="${key}"]`) as HTMLElement

          // Bei Deaktivierung: pruefen ob Drucker betroffen sind
          if (!newState) {
            try {
              const infoResp = await fetch(`/api/v1/admin/system/plugins/${key}/affected-printers`, {
                credentials: 'include',
                signal: getAbortSignal(),
              })
              if (infoResp.ok) {
                const info = await infoResp.json()
                if (info.count > 0) {
                  if (document.querySelector('#fm-confirm-overlay[open]')) {
                    checkbox.checked = true
                    return
                  }
                  const msg = t('admin.pluginDeactivateConfirm').replace('{count}', info.count)
                  const confirmed = await fm.__fmConfirm(msg, {
                    title: t('admin.pluginDeactivate'),
                    isDanger: true,
                  })
                  if (!confirmed) {
                    checkbox.checked = true
                    return
                  }
                }
              }
            } catch (err) {
              if (isAbortError(err)) return
              // Bei Fehler trotzdem fortfahren (Vorschau ist optional)
            }
          }

          // Spinner anzeigen + Toggle deaktivieren
          checkbox.disabled = true
          if (spinner) spinner.classList.add('visible')
          
          try {
            await api.patch(`/admin/system/plugins/${key}/active`, { is_active: newState })

            // Lokalen State aktualisieren
            const plugin = plugins.find(p => p.plugin_key === key)
            if (plugin) plugin.is_active = newState
            
            // Tooltip aktualisieren
            const label = checkbox.closest('.fm-toggle') as HTMLElement
            if (label) label.title = newState ? t('admin.pluginDeactivate') : t('admin.pluginActivate')
            const status = checkbox.closest('.plugin-state')!.querySelector('.plugin-mobile-label')!
            status.textContent = t(newState ? 'common.active' : 'common.inactive')
            
          } catch (err) {
            if (isAbortError(err)) return
            // Bei Fehler: Checkbox zuruecksetzen
            checkbox.checked = !newState
            showMessage(err instanceof Error ? err.message : t('admin.pluginToggleFailed'), true)
          } finally {
            checkbox.disabled = false
            if (spinner) spinner.classList.remove('visible')
          }
        })
      })
    }

    function setInstalledUpdateControlsDisabled(disabled: boolean, opener?: HTMLButtonElement) {
      for (const button of document.querySelectorAll<HTMLButtonElement>('.btn-update, #btn-browse-plugins, #btn-install, #btn-update-all')) {
        if (button !== opener) button.disabled = disabled
      }
    }

    function updateAllVisibility() {
      updateAllButton.hidden = updateMap.size < 2
    }

    updateAllButton.addEventListener('click', () => {
      const releases = Array.from(updateMap.values())
      if (releases.length > 1) void runUpdates(releases, updateAllButton)
    })

    function updateLabel(release: RegistryPlugin) {
      return t('admin.pluginUpdateTo').replace('{version}', () => release.version)
    }

    async function runUpdates(releases: RegistryPlugin[], opener: HTMLButtonElement) {
      if (updating || installing) return
      const first = releases[0]
      const bulk = releases.length > 1
      updating = true
      setInstalledUpdateControlsDisabled(true, opener)
      opener.focus({ preventScroll: true })
      let stale = false
      let installedAny = false
      try {
        const confirmed = bulk
          ? await fm.__fmConfirm(
            t('admin.pluginConfirmUpdateAll').replace('{count}', String(releases.length)) +
              '\n\n' + releases.map(p => `${p.name} v${p.version} · ${p.publisher}`).join('\n'),
            { title: t('admin.pluginUpdateAll'), okLabel: t('admin.pluginUpdateAll'), isDanger: false },
          )
          : await confirmRelease(first)
        if (!confirmed) return
        opener.disabled = true
        showMessage('')
        for (const release of releases) {
          const key = release.plugin_key
          pendingUpdate = key
          const actionLabel = () => document.querySelector(`.btn-update[data-key="${CSS.escape(key)}"] span`)
          const label = actionLabel()
          if (label) label.textContent = t('admin.pluginUpdating')
          showUpdateMessage(key, '')
          try {
            const result = await installRelease(release)
            installedAny = true
            showUpdateMessage(key, result.message || `${t('common.successTitle')} · v${result.plugin.version}`)
            invalidateUpdate(key)
          } catch (err) {
            if (isAbortError(err)) return
            if (releaseIsStale(err)) {
              stale = true
              invalidateUpdate(key)
              showUpdateMessage(key, t('admin.pluginCatalogChanged'), true)
            } else {
              console.error('Plugin update failed:', err)
              showUpdateMessage(key, err instanceof Error ? err.message : t('admin.pluginInstallFailed'), true)
            }
          } finally {
            pendingUpdate = null
            const currentLabel = actionLabel()
            if (currentLabel) currentLabel.textContent = updateLabel(release)
          }
        }
        if (installedAny) await loadPlugins()
        else if (stale) renderPlugins()
        if (stale) {
          try {
            await refreshUpdateActions()
          } catch (err) {
            if (!isAbortError(err)) console.error('Plugin catalog refresh failed:', err)
          }
        }
      } finally {
        updating = false
        setInstalledUpdateControlsDisabled(false)
        if (document.activeElement === document.body) {
          const key = CSS.escape(first.plugin_key)
          const next = bulk
            ? (updateAllButton.hidden ? checkUpdatesButton : updateAllButton)
            : document.querySelector<HTMLButtonElement>(`.btn-update[data-key="${key}"], .btn-detail[data-key="${key}"]`)
          next?.focus({ preventScroll: true })
        }
      }
    }

    function showUpdateMessage(key: string, text: string, error = false) {
      if (text) updateMessages.set(key, { text, error })
      else updateMessages.delete(key)
      const host = document.querySelector<HTMLElement>(`[data-update-message="${CSS.escape(key)}"]`)
      if (!host) return
      host.className = `plugin-update-message ${text ? (error ? 'fm-alert-error' : 'fm-alert-success') : ''}`
      host.setAttribute('role', error ? 'alert' : 'status')
      host.textContent = text
    }
    
    // ----------------------------------------------------------------
    //  Plugin-Details anzeigen
    // ----------------------------------------------------------------
    
    function showPluginDetails(key: string) {
      const plugin = plugins.find(p => p.plugin_key === key)
      if (!plugin) return
      
      const title = document.getElementById('detail-title')!
      const content = document.getElementById('detail-content')!
      
      title.textContent = plugin.name
      title.classList.add('fm-plugin-name')
      title.prepend(createPluginIcon(plugin.icon_url))
      
      const rows = [
        { label: 'Plugin Key', value: plugin.plugin_key },
        { label: t('admin.pluginVersion'), value: plugin.version },
        { label: t('admin.pluginType'), value: plugin.plugin_type },
        { label: t('admin.pluginAuthor'), value: plugin.author || '-' },
        ...(plugin.driver_key ? [{ label: t('admin.pluginDriver'), value: plugin.driver_key }] : []),
        { label: t('admin.pluginDescription'), value: plugin.description || '-' },
        { label: t('admin.pluginHomepage'), value: plugin.homepage || '-', link: true },
        { label: t('admin.pluginLicense'), value: plugin.license || '-' },
        { label: t('admin.pluginInstalledAt'), value: new Date(plugin.installed_at).toLocaleString() },
      ]
      
      content.innerHTML = rows.map(r => `
        <div class="plugin-detail-row">
          <span style="color:var(--text-muted)">${escapeHtml(r.label)}</span>
          <span class="plugin-detail-value">${r.link && /^https?:\/\//i.test(String(r.value)) ? `<a href="${escapeHtml(String(r.value))}" target="_blank" rel="noopener noreferrer">${escapeHtml(String(r.value))}</a>` : escapeHtml(String(r.value))}</span>
        </div>
      `).join('')
      
      // Config Schema anzeigen
      if (plugin.config_schema && Object.keys(plugin.config_schema).length > 0) {
        content.innerHTML += `
          <div style="margin-top: 8px;">
            <span style="font-weight: 600; font-size: 0.9rem;" data-i18n="admin.pluginConfigSchema">Configuration Schema</span>
            <pre class="plugin-schema">${escapeHtml(JSON.stringify(plugin.config_schema, null, 2))}</pre>
          </div>
        `
      }
      
      detailDialog.open()
    }
    
    // ----------------------------------------------------------------
    //  Install-Modal: Drag & Drop, Dateiauswahl, Upload
    // ----------------------------------------------------------------
    
    const dropZone = document.getElementById('drop-zone')!
    const fileInput = document.getElementById('file-input') as HTMLInputElement
    const fileName = document.getElementById('file-name')!
    const installForm = document.getElementById('install-form') as HTMLFormElement
    const installSubmit = document.getElementById('install-submit') as HTMLButtonElement
    const installClose = document.getElementById('install-cancel') as HTMLButtonElement
    
    const catalogBrowser = document.getElementById('catalog-browser')!
    const catalogSearch = document.getElementById('catalog-search') as HTMLInputElement
    const catalogFilter = document.getElementById('catalog-filter') as HTMLSelectElement
    const catalogStatus = document.getElementById('catalog-status')!
    const catalogList = document.getElementById('catalog-list')!
    const catalogRetry = document.getElementById('catalog-retry')!
    const catalogProgress = document.getElementById('catalog-progress')!
    const installSuccess = document.getElementById('validation-details')!
    const installError = document.getElementById('error-details')!
    const installProgress = document.getElementById('upload-progress')!
    const desktopInstaller = matchMedia('(min-width: 641px)')
    let catalogRequest = 0

    document.getElementById('btn-browse-plugins')?.addEventListener('click', () => openInstaller(true))
    document.getElementById('btn-install')?.addEventListener('click', () => openInstaller(false))

    function openInstaller(browse: boolean) {
      catalogRequest++
      availablePlugins = []
      catalogList.replaceChildren()
      selectedFile = null
      installModal.classList.toggle('catalog-dialog', browse)
      catalogBrowser.hidden = !browse
      installSubmit.hidden = browse
      document.getElementById('plugin-zip-upload')!.hidden = browse
      const title = document.getElementById('install-title')!
      title.dataset.i18n = browse ? 'admin.pluginBrowse' : 'admin.installPlugin'
      title.textContent = t(title.dataset.i18n)
      installClose.dataset.i18n = browse ? 'common.close' : 'common.cancel'
      installClose.textContent = t(installClose.dataset.i18n)
      catalogSearch.value = ''
      catalogFilter.value = 'all'
      fileInput.value = ''
      fileName.style.display = 'none'
      fileName.textContent = ''
      installSubmit.disabled = true
      clearInstallResult()
      dropZone.style.borderColor = 'var(--border)'
      dropZone.style.background = 'transparent'
      installDialog.open()
      if (browse) {
        if (desktopInstaller.matches) catalogSearch.focus()
        loadAvailablePlugins()
      }
    }
    
    // Klick auf Drop-Zone oeffnet Dateiauswahl
    dropZone.addEventListener('click', () => fileInput.click())
    dropZone.addEventListener('keydown', event => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); fileInput.click() }
    })
    
    // Drag & Drop
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault()
      dropZone.style.borderColor = 'var(--accent)'
      dropZone.style.background = 'var(--bg-soft)'
    })
    
    dropZone.addEventListener('dragleave', () => {
      dropZone.style.borderColor = 'var(--border)'
      dropZone.style.background = 'transparent'
    })
    
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault()
      dropZone.style.borderColor = 'var(--border)'
      dropZone.style.background = 'transparent'
      
      const files = e.dataTransfer?.files
      if (files && files.length > 0) {
        handleFileSelect(files[0])
      }
    })
    
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFileSelect(fileInput.files[0])
      }
    })
    
    function handleFileSelect(file: File) {
      // ZIP-Pruefung
      if (!file.name.endsWith('.zip')) {
        showValidationError(t('admin.pluginNotZip'))
        return
      }
      
      // Groessen-Pruefung (10 MB)
      if (file.size > 10 * 1024 * 1024) {
        showValidationError(t('admin.pluginTooLarge'))
        return
      }
      
      selectedFile = file
      fileName.textContent = file.name + ` (${(file.size / 1024).toFixed(1)} KB)`
      fileName.style.display = 'block'
      installSubmit.disabled = false
      
      clearInstallResult()
    }

    function clearInstallResult() {
      installSuccess.hidden = true
      installError.hidden = true
      installError.textContent = ''
    }

    function showValidationError(message: string) {
      installSuccess.hidden = true
      installError.hidden = false
      installError.textContent = message
      installSubmit.disabled = true
    }
    
    // Upload / Install
    installForm.addEventListener('submit', e => {
      e.preventDefault()
      if (catalogBrowser.hidden && selectedFile && !installSubmit.disabled) void installPlugin()
    })
    async function installPlugin(release?: RegistryPlugin, submit = installSubmit) {
      if (installing) return
      installing = true
      const label = submit.querySelector('span')!
      const action = label.textContent
      installForm.inert = true
      installForm.setAttribute('aria-busy', 'true')
      installClose.disabled = true
      submit.disabled = true
      clearInstallResult()
      if (release) {
        const progress = t(release.update_available ? 'admin.pluginUpdating' : 'admin.pluginInstalling')
        label.textContent = progress
        catalogProgress.textContent = progress
      } else {
        installProgress.hidden = false
      }
      let focusAfterInstall: HTMLElement | undefined
      
      try {
        let result: InstallResult
        if (release) {
          result = await installRelease(release)
        } else {
          const formData = new FormData()
          formData.append('file', selectedFile!)
          result = await request<InstallResult>('/admin/system/plugins/install', { method: 'POST', body: formData })
        }
        const message = result.message || `${result.plugin.name} v${result.plugin.version}`
        installSuccess.hidden = false
        installSuccess.textContent = message
        
        selectedFile = null
        invalidateUpdate(result.plugin.plugin_key)
        if (release) {
          loadAvailablePlugins()
          focusAfterInstall = desktopInstaller.matches ? catalogSearch : installClose
        }
        showMessage(message)
        loadPlugins()
      } catch (err) {
        if (isAbortError(err)) return
        if (release && releaseIsStale(err)) {
          invalidateUpdate(release.plugin_key)
          renderPlugins()
          showValidationError(t('admin.pluginCatalogChanged'))
          loadAvailablePlugins()
          focusAfterInstall = desktopInstaller.matches ? catalogSearch : installClose
        } else {
          showValidationError(err instanceof Error ? err.message : t('admin.pluginInstallFailed'))
        }
      } finally {
        installing = false
        installProgress.hidden = true
        catalogProgress.textContent = ''
        installForm.inert = false
        installForm.setAttribute('aria-busy', 'false')
        installClose.disabled = false
        label.textContent = action
        submit.disabled = !release && !selectedFile
        if (installModal.open) (focusAfterInstall ?? (submit.disabled ? installClose : submit)).focus({ preventScroll: true })
      }
    }

    // ----------------------------------------------------------------
    //  Registry: Verfuegbare Plugins laden
    // ----------------------------------------------------------------

    function confirmRelease(p: RegistryPlugin) {
      const message = t(p.update_available ? 'admin.pluginConfirmUpdateRelease' : 'admin.pluginConfirmRelease')
        .replace('{name}', () => p.name)
        .replace('{version}', () => p.version)
        .replace('{publisher}', () => p.publisher)
      return fm.__fmConfirm(message, {
        title: t(p.update_available ? 'admin.pluginConfirmUpdateAction' : 'admin.pluginConfirmInstallAction'),
        okLabel: t(p.update_available ? 'admin.pluginUpdateTo' : 'admin.installPlugin').replace('{version}', () => p.version),
        isDanger: false,
      })
    }

    function installRelease({ plugin_key, version, release_id }: RegistryPlugin) {
      return api.post<InstallResult>('/admin/system/plugins/install-from-registry', { plugin_key, version, release_id })
    }

    function releaseIsStale(error: unknown) {
      return error instanceof ApiError && ['catalog_release_unavailable', 'catalog_downgrade'].includes(error.code)
    }

    function invalidateUpdate(key: string) {
      updateRequest++
      updateMap.delete(key)
      updateAllVisibility()
    }

    async function refreshUpdateActions(): Promise<number | null> {
      const currentRequest = ++updateRequest
      try {
        const releases = await api.get<RegistryPlugin[]>('/admin/system/plugins/available')
        if (currentRequest !== updateRequest) return null
        const updates = releases.filter(release => release.update_available)
        updateMap = new Map(updates.map(release => [release.plugin_key, release]))
        updateAllVisibility()
        renderPlugins()
        return updates.length
      } catch (err) {
        if (currentRequest !== updateRequest) return null
        throw err
      }
    }

    async function loadAvailablePlugins() {
      const currentRequest = ++catalogRequest
      catalogList.replaceChildren()
      availablePlugins = []
      catalogRetry.hidden = true
      catalogStatus.textContent = t('common.loading')
      try {
        const releases = await api.get<RegistryPlugin[]>('/admin/system/plugins/available')
        if (currentRequest !== catalogRequest) return
        availablePlugins = releases.sort((a, b) => a.name.localeCompare(b.name))
        renderCatalog()
      } catch (err) {
        if (currentRequest !== catalogRequest || isAbortError(err)) return
        catalogStatus.textContent = t('admin.pluginRegistryFailed')
        catalogRetry.hidden = false
      }
    }

    function renderCatalog() {
      const query = catalogSearch.value.trim().toLocaleLowerCase()
      const filter = catalogFilter.value
      const matches = availablePlugins.filter(p => {
        if (filter === 'installed' && !p.is_installed) return false
        if (filter === 'uninstalled' && p.is_installed) return false
        if (filter === 'updates' && !p.update_available) return false
        return [p.name, p.description, p.publisher].some(value => value.toLocaleLowerCase().includes(query))
      })
      catalogList.innerHTML = matches.map(p => {
        const requirement = t('admin.pluginRequiresFilaMan').replace('{version}', p.min_filaman_version)
        let blocked = ''
        if (p.requires_newer_zip) {
          blocked = t('admin.pluginRequiresNewerZip').replace('{version}', p.installed_version ?? '')
        } else if (!p.is_compatible) {
          blocked = requirement
        }
        const offersInstall = !p.is_installed || p.update_available
        const canUpdate = p.is_installed && p.update_available
        const version = p.is_installed ? p.installed_version || p.version : p.version
        const action = p.update_available
          ? t('admin.pluginUpdateTo').replace('{version}', p.version)
          : t('admin.installPlugin')
        const actionIcon = p.update_available
          ? '<use href="/icons.svg?v=2#icon-change-status"></use>'
          : '<path d="M12 3v12m-5-5 5 5 5-5M5 21h14"/>'
        return `<li class="catalog-card">
          <div class="catalog-heading">
            <span class="catalog-icon"></span>
            <div>
              <h3>${escapeHtml(p.name)}</h3>
              <p class="fm-field-hint"><a class="catalog-publisher" href="${escapeHtml(p.repository_url)}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(p.publisher)} · ${escapeHtml(p.name)} · GitHub">${escapeHtml(p.publisher)}</a></p>
            </div>
            <span class="catalog-version-info">
              <span class="catalog-version${canUpdate ? ' catalog-version-outdated' : ''}">v${escapeHtml(version)}</span>
              ${p.is_installed ? `<span class="catalog-version-label">${escapeHtml(t('admin.pluginInstalledLabel'))}</span>` : ''}
            </span>
          </div>
          <p class="catalog-description">${escapeHtml(p.description)}</p>
          ${blocked || offersInstall ? `<div class="catalog-footer">
            <p class="fm-field-hint">${escapeHtml(blocked || requirement)}</p>
            ${!blocked && offersInstall ? `<button type="button" class="fm-btn fm-btn-primary" data-release="${escapeHtml(p.plugin_key)}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${actionIcon}</svg><span>${escapeHtml(action)}</span></button>` : ''}
          </div>` : ''}
        </li>`
      }).join('')
      catalogList.querySelectorAll('.catalog-icon').forEach((host, index) => {
        host.append(createPluginIcon(matches[index].icon_url))
      })
      catalogStatus.textContent = matches.length ? '' : t(availablePlugins.length ? 'admin.pluginNoMatches' : 'admin.pluginNoAvailable')
    }

    catalogSearch.addEventListener('keydown', event => {
      if (event.key === 'Enter') event.preventDefault()
    })
    function applyCatalogFilters() {
      if (availablePlugins.length) renderCatalog()
    }
    catalogSearch.addEventListener('input', applyCatalogFilters)
    catalogFilter.addEventListener('change', applyCatalogFilters)
    catalogRetry.addEventListener('click', loadAvailablePlugins)
    catalogList.addEventListener('click', async event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-release]')
      if (!button || installing) return
      const release = availablePlugins.find(p => p.plugin_key === button.dataset.release)
      if (!release) return
      button.focus({ preventScroll: true })
      if (await confirmRelease(release) && installModal.open && button.isConnected) {
        await installPlugin(release, button)
      }
    })

    // ----------------------------------------------------------------
    //  Auf Aktualisierungen pruefen
    // ----------------------------------------------------------------

    checkUpdatesButton.addEventListener('click', async () => {
      const btn = checkUpdatesButton
      const label = btn.querySelector('span')!
      btn.disabled = true
      label.textContent = t('admin.pluginCheckingUpdates')

      try {
        const count = await refreshUpdateActions()
        if (count === null) return

        if (count === 0) {
          showMessage(t('admin.pluginUpToDate'))
        } else {
          const msg = t('admin.pluginUpdatesAvailable').replace('{count}', String(count))
          showMessage(msg)
        }

      } catch (err) {
        if (isAbortError(err)) return
        console.error('Update check failed:', err)
        showMessage(err instanceof Error ? err.message : t('admin.pluginRegistryFailed'), true)
      } finally {
        btn.disabled = false
        label.textContent = t('admin.pluginCheckUpdates')
      }
    })
    
    // ----------------------------------------------------------------
    //  Initialisierung
    // ----------------------------------------------------------------
    
    loadPlugins()
  </script>
</Layout>
