---
import Layout from '../../../layouts/Layout.astro'
---

<Layout title="FilaMan - Spoolman Import">
  <div style="margin-bottom: 24px;">
    <a href="/admin/system" style="color: var(--accent); text-decoration: none;">&larr; <span data-i18n="admin.backToSystem">Back to System</span></a>
  </div>
  
  <h1 style="font-size: 1.8rem; font-weight: 700; margin: 0 0 8px; font-family: var(--font-serif);" data-i18n="spoolman.title">Spoolman Import</h1>
  <p style="color: var(--text-muted); margin-bottom: 24px;" data-i18n="spoolman.subtitle">Import filaments, spools, manufacturers, and locations from a Spoolman instance.</p>

  <!-- Step 1: Connection -->
  <div class="fm-card" style="margin-bottom: 24px; padding: 24px;" id="step-connection">
    <h2 style="font-size: 1.1rem; font-weight: 600; margin: 0 0 16px;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 0.85rem; margin-right: 10px;">1</span>
      <span data-i18n="spoolman.stepConnection">Connection</span>
    </h2>
    <div style="display: flex; gap: 12px; align-items: flex-end;">
      <div style="flex: 1;">
        <label class="fm-label" data-i18n="spoolman.spoolmanUrl">Spoolman URL</label>
        <input type="url" id="spoolman-url" class="fm-input" placeholder="http://192.168.1.100:7912" style="width: 100%;" />
      </div>
      <button id="btn-test" class="fm-btn fm-btn-primary" data-i18n="spoolman.testConnection">Test Connection</button>
    </div>
    <div id="connection-result" style="margin-top: 12px; display: none;"></div>
  </div>

  <!-- Step 2: Preview -->
  <div class="fm-card" style="margin-bottom: 24px; padding: 24px; opacity: 0.5; pointer-events: none;" id="step-preview">
    <h2 style="font-size: 1.1rem; font-weight: 600; margin: 0 0 16px;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 0.85rem; margin-right: 10px;">2</span>
      <span data-i18n="spoolman.stepPreview">Preview</span>
    </h2>
    <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.9rem;" data-i18n="spoolman.previewDesc">Review the data that will be imported from Spoolman.</p>
    <button id="btn-preview" class="fm-btn fm-btn-outline" data-i18n="spoolman.loadPreview">Load Preview</button>
    <div id="preview-result" style="margin-top: 16px; display: none;"></div>
  </div>

  <!-- Step 3: Import -->
  <div class="fm-card" style="margin-bottom: 24px; padding: 24px; opacity: 0.5; pointer-events: none;" id="step-import">
    <h2 style="font-size: 1.1rem; font-weight: 600; margin: 0 0 16px;">
      <span style="display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 0.85rem; margin-right: 10px;">3</span>
      <span data-i18n="spoolman.stepImport">Import</span>
    </h2>
    <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.9rem;" data-i18n="spoolman.importDesc">Start the import. Existing data will not be overwritten.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items: flex-start; margin-bottom: 12px;">
      <div style="max-width:680px;min-width:280px;flex:1 1 auto;">
        <label class="fm-label" for="extra-field-mode" data-i18n="spoolman.extraFieldMode">Spoolman extra fields</label>
        <select id="extra-field-mode" class="fm-select" style="width:100%;">
          <option value="system" selected data-i18n="spoolman.extraFieldModeSystem">Create or reuse System Extra Fields</option>
          <option value="local" data-i18n="spoolman.extraFieldModeLocal">Create filament- or spool-specific typed fields</option>
          <option value="preserve" data-i18n="spoolman.extraFieldModePreserve">Preserve source values unchanged under spoolman_extra</option>
          <option value="legacy" data-i18n="spoolman.extraFieldModeLegacy">Legacy import: keep values under spoolman_extra</option>
        </select>
        <p style="color:var(--text-muted);font-size:0.82rem;margin:6px 0 0;" data-i18n="spoolman.extraFieldModeHint">Choose a default here, then optionally override individual fields in the preview.</p>
      </div>
      <button id="btn-import" class="fm-btn fm-btn-primary" data-i18n="spoolman.startImport">Start Import</button>
      <button id="btn-repair-transparency" class="fm-btn fm-btn-outline hidden">Fix transparency hex</button>
    </div>
    <div id="transparency-repair-note" class="hidden" style="margin-top: 12px; padding: 12px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--accent-2);">
      <strong id="transparency-repair-count" style="color: var(--accent);"></strong>
      <p style="margin: 4px 0 0; color: var(--text-muted); font-size: 0.85rem;" data-i18n="spoolman.repairTransparencyDesc">
        Repairs only existing filament color assignments linked by spoolman_id to the connected Spoolman data. No manufacturers, locations, filaments, spools, or unrelated fields are imported.
      </p>
    </div>
    <div id="import-progress" style="margin-top: 16px; display: none;">
      <div style="background: var(--bg-soft); border-radius: 999px; overflow: hidden; height: 8px;">
        <div id="import-bar" style="background: var(--accent); height: 100%; width: 0%; transition: width 0.5s;"></div>
      </div>
      <p id="import-status" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 6px; text-align: center;" data-i18n="spoolman.importing">Importing...</p>
    </div>
    <div id="import-result" style="margin-top: 16px; display: none;"></div>
  </div>

  <div class="fm-card" style="margin-bottom: 24px; padding: 24px;" id="repair-imports">
    <h2 style="font-size: 1.1rem; font-weight: 600; margin: 0 0 8px;" data-i18n="spoolman.repairTitle">Repair previous Spoolman imports</h2>
    <p style="color: var(--text-muted); margin: 0 0 16px; font-size: 0.9rem;" data-i18n="spoolman.repairDesc">Convert extra values from earlier imports into native typed fields. Existing values are never overwritten.</p>
    <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:8px;">
      <label style="display:flex;align-items:center;gap:7px;cursor:pointer;white-space:nowrap;">
        <input type="radio" name="repair-mode" value="server" />
        <span data-i18n="spoolman.repairServerMode">Use running Spoolman server</span>
      </label>
      <label style="display:flex;align-items:center;gap:7px;cursor:pointer;white-space:nowrap;">
        <input type="radio" name="repair-mode" value="offline" checked />
        <span data-i18n="spoolman.repairOfflineMode">Recover from stored imported data</span>
      </label>
    </div>
    <p style="color:var(--text-muted);font-size:0.82rem;margin:0 0 16px;" data-i18n="spoolman.repairOfflineHint">No source server is required. Suggested mappings must be reviewed and approved individually.</p>
    <button id="btn-repair-preview" class="fm-btn fm-btn-outline" data-i18n="spoolman.repairPreview">Scan existing imports</button>
    <div id="repair-preview-result" style="margin-top:16px;display:none;"></div>
    <div id="repair-actions" style="margin-top:16px;display:none;">
      <button id="btn-repair-execute" class="fm-btn fm-btn-primary" data-i18n="spoolman.repairApply">Apply approved repairs</button>
    </div>
    <div id="repair-result" style="margin-top:16px;display:none;"></div>
  </div>

  <style is:global>
    #repair-preview-result .repair-mapping-list {
      display: grid;
      gap: 14px;
    }

    #repair-preview-result .repair-mapping-card {
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--bg-soft);
    }

    #repair-preview-result .repair-mapping-header {
      display: grid;
      grid-template-columns: minmax(220px, 0.9fr) minmax(380px, 1.6fr);
      align-items: start;
      gap: 24px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }

    #repair-preview-result .repair-field-heading {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      min-width: 0;
      cursor: pointer;
    }

    #repair-preview-result .repair-field-heading input {
      margin-top: 3px;
    }

    #repair-preview-result
      :is(.repair-section-label, .repair-control > span) {
      color: var(--text-muted);
      font-size: 0.72rem;
      font-weight: 650;
      line-height: 1.3;
    }

    #repair-preview-result .repair-section-label {
      display: block;
      margin-bottom: 4px;
    }

    #repair-preview-result .repair-field-key {
      display: block;
      overflow-wrap: anywhere;
      font-size: 0.9rem;
    }

    #repair-preview-result .repair-controls {
      display: grid;
      grid-template-columns:
        minmax(200px, 1.25fr)
        minmax(150px, 0.8fr)
        minmax(170px, 1fr)
        minmax(210px, 1.15fr);
      align-items: end;
      gap: 12px;
      padding: 14px 0;
    }

    #repair-preview-result .repair-control {
      display: grid;
      grid-template-rows: minmax(2em, auto) auto;
      gap: 5px;
      min-width: 0;
    }

    #repair-preview-result .repair-control > span {
      align-self: end;
    }

    #repair-preview-result .repair-control :is(input, select) {
      width: 100%;
      min-width: 0;
    }

    #repair-preview-result .repair-confidence-content {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      align-items: start;
      gap: 16px;
    }

    #repair-preview-result .repair-confidence-rating {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    #repair-preview-result .repair-conversion-preview {
      background: var(--bg);
    }

    #repair-preview-result .repair-example-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 8px;
    }

    #repair-preview-result .repair-example {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 8px;
      min-width: 0;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg);
    }

    #repair-preview-result .repair-example code {
      min-width: 0;
      white-space: normal;
      overflow-wrap: anywhere;
      line-height: 1.35;
    }

    @media (max-width: 1050px) {
      #repair-preview-result .repair-mapping-header {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      #repair-preview-result .repair-controls {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      #repair-preview-result .repair-controls {
        grid-template-columns: 1fr;
      }

      #repair-preview-result .repair-confidence-content {
        grid-template-columns: 1fr;
        gap: 6px;
      }
    }
  </style>

  <script>
    import { t, initI18n } from '../../../lib/i18n'
    import { getAbortSignal, isAbortError } from '../../../lib/abort'
    import { toColorSwatchBackground } from '../../../lib/colors'
    import {
      RepairMappingValidationError,
      buildImportFieldActions,
      buildRepairMappingPayload,
      convertRepairExampleValue,
      formatRepairExampleValue,
      repairConfidenceReason,
      repairConfidenceTone,
      repairDetailsState,
      repairFieldTypes,
      resolveImportDefinitionAvailability,
      resolveImportModeAvailability,
      type ImportDefinitionAvailability,
      type ImportStorageAction,
      type ImportStorageMode,
      type RepairFieldType,
      type RepairMapping,
      type RepairStorageAction,
    } from '../../../lib/spoolman-extra-field-ui'
    await initI18n()

    let connectedUrl = ''
    let previewData: any = null
    let transparencyRepairCandidates = 0
    let transparencyRepairPlanDigest = ''
    let repairPreview: any = null
    let importActionRunning = false

    function getCsrfToken(): string {
      const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]*)/)
      return match ? decodeURIComponent(match[1]) : ''
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div')
      div.textContent = str
      return div.innerHTML
    }

    function enableStep(id: string) {
      const el = document.getElementById(id)!
      el.style.opacity = '1'
      el.style.pointerEvents = 'auto'
    }

    function disableStep(id: string) {
      const el = document.getElementById(id)!
      el.style.opacity = '0.5'
      el.style.pointerEvents = 'none'
    }

    function updateTransparencyRepairAction(count: number, planDigest = '') {
      transparencyRepairCandidates = Math.max(0, Number(count) || 0)
      transparencyRepairPlanDigest =
        transparencyRepairCandidates > 0 ? String(planDigest) : ''
      const button = document.getElementById('btn-repair-transparency') as HTMLButtonElement
      const note = document.getElementById('transparency-repair-note')!
      const countLabel = document.getElementById('transparency-repair-count')!
      const hasCandidates = transparencyRepairCandidates > 0

      button.classList.toggle('hidden', !hasCandidates)
      note.classList.toggle('hidden', !hasCandidates)
      if (!hasCandidates) return

      button.textContent = t('spoolman.repairTransparency').replace(
        '{count}',
        String(transparencyRepairCandidates)
      )
      countLabel.textContent = t('spoolman.repairTransparencyAvailable').replace(
        '{count}',
        String(transparencyRepairCandidates)
      )
    }

    // ----------------------------------------------------------------
    //  Step 1: Test Connection
    // ----------------------------------------------------------------

    document.getElementById('btn-test')?.addEventListener('click', async () => {
      const urlInput = document.getElementById('spoolman-url') as HTMLInputElement
      const url = urlInput.value.trim()
      const resultDiv = document.getElementById('connection-result')!
      const btn = document.getElementById('btn-test') as HTMLButtonElement

      if (!url) {
        resultDiv.style.display = 'block'
        resultDiv.innerHTML = `<div style="padding: 10px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">${escapeHtml(t('spoolman.urlRequired'))}</div>`
        return
      }

      btn.disabled = true
      btn.textContent = t('spoolman.testing')
      resultDiv.style.display = 'none'

      try {
        const response = await fetch('/api/v1/admin/system/spoolman-import/test-connection', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify({ url }),
          signal: getAbortSignal(),
        })

        resultDiv.style.display = 'block'

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('spoolman.connectionFailed'))
        }

        const data = await response.json()
        connectedUrl = url
        previewData = null
        updateTransparencyRepairAction(0)

        resultDiv.innerHTML = `
          <div style="padding: 10px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--accent-2); color: var(--text);">
            <strong style="color: var(--accent);">${escapeHtml(t('spoolman.connectionSuccess'))}</strong>
            <div style="font-size: 0.85rem; margin-top: 4px; color: var(--text-muted);">URL: ${escapeHtml(data.url)}</div>
          </div>
        `

        // Enable step 2
        enableStep('step-preview')

      } catch (err: any) {
        if (isAbortError(err)) return
        resultDiv.innerHTML = `
          <div style="padding: 10px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">
            ${escapeHtml(err.message)}
          </div>
        `
        disableStep('step-preview')
        disableStep('step-import')
        updateTransparencyRepairAction(0)
      } finally {
        btn.disabled = false
        btn.textContent = t('spoolman.testConnection')
      }
    })

    // ----------------------------------------------------------------
    //  Step 2: Preview
    // ----------------------------------------------------------------

    document.getElementById('btn-preview')?.addEventListener('click', async () => {
      const resultDiv = document.getElementById('preview-result')!
      const btn = document.getElementById('btn-preview') as HTMLButtonElement

      btn.disabled = true
      btn.textContent = t('spoolman.loadingPreview')
      resultDiv.style.display = 'none'

      try {
        const response = await fetch('/api/v1/admin/system/spoolman-import/preview', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify({
            url: connectedUrl,
            include_transparency_repairs: true,
          }),
          signal: getAbortSignal(),
        })

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          throw new Error(data.detail?.message || t('spoolman.previewFailed'))
        }

        previewData = await response.json()
        const definitionAvailability =
          syncImportModeAvailability(previewData)
        updateTransparencyRepairAction(
          previewData.transparency_repair_candidates,
          previewData.transparency_repair_plan_digest
        )
        resultDiv.style.display = 'block'

        const s = previewData.summary
        resultDiv.innerHTML = `
          <div class="fm-card" style="padding: 0;">
            <table class="fm-table">
              <thead style="background: var(--bg-soft);">
                <tr>
                  <th data-i18n="spoolman.dataType">${escapeHtml(t('spoolman.dataType'))}</th>
                  <th style="text-align: right;" data-i18n="spoolman.count">${escapeHtml(t('spoolman.count'))}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>${escapeHtml(t('spoolman.previewVendors'))}</td>
                  <td style="text-align: right; font-weight: 600;">${s.vendors}</td>
                </tr>
                <tr>
                  <td>${escapeHtml(t('spoolman.previewLocations'))}</td>
                  <td style="text-align: right; font-weight: 600;">${s.locations}</td>
                </tr>
                <tr>
                  <td>${escapeHtml(t('spoolman.previewColors'))}</td>
                  <td style="text-align: right; font-weight: 600;">${s.colors}</td>
                </tr>
                <tr>
                  <td>${escapeHtml(t('spoolman.previewFilaments'))}</td>
                  <td style="text-align: right; font-weight: 600;">${s.filaments}</td>
                </tr>
                <tr>
                  <td>${escapeHtml(t('spoolman.previewSpools'))}</td>
                  <td style="text-align: right; font-weight: 600;">${s.spools}</td>
                </tr>
              </tbody>
            </table>
          </div>
          ${renderVendorPreview(previewData.vendors)}
          ${renderFilamentPreview(previewData.filaments)}
          ${renderSpoolPreview(previewData.spools)}
          ${renderExtraFieldPreview(
            previewData.extra_fields || [],
            definitionAvailability,
          )}
        `

        // Enable step 3
        enableStep('step-import')

      } catch (err: any) {
        if (isAbortError(err)) return
        resultDiv.style.display = 'block'
        resultDiv.innerHTML = `
          <div style="padding: 10px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">
            ${escapeHtml(err.message)}
          </div>
        `
        disableStep('step-import')
        updateTransparencyRepairAction(0)
      } finally {
        btn.disabled = false
        btn.textContent = t('spoolman.loadPreview')
      }
    })

    function renderVendorPreview(vendors: any[]): string {
      if (!vendors.length) return ''
      const rows = vendors.slice(0, 20).map(v => `
        <tr>
          <td>${escapeHtml(v.name || '-')}</td>
          <td style="color: var(--text-muted); font-size: 0.85rem;">${escapeHtml(v.url || '-')}</td>
        </tr>
      `).join('')
      const more = vendors.length > 20 ? `<tr><td colspan="2" style="text-align: center; color: var(--text-muted); font-style: italic;">... ${t('spoolman.andMore').replace('{count}', String(vendors.length - 20))}</td></tr>` : ''
      return `
        <details style="margin-top: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--accent);">${escapeHtml(t('spoolman.previewVendors'))} (${vendors.length})</summary>
          <table class="fm-table" style="margin-top: 8px;">
            <thead style="background: var(--bg-soft);"><tr><th>${escapeHtml(t('common.name'))}</th><th>URL</th></tr></thead>
            <tbody>${rows}${more}</tbody>
          </table>
        </details>
      `
    }

    function renderFilamentPreview(filaments: any[]): string {
      if (!filaments.length) return ''
      const rows = filaments.slice(0, 20).map(f => {
        const vendor = f.vendor?.name || '-'
        const colorSwatch = f.color_hex
          ? `<span style="display: inline-block; width: 16px; height: 16px; border-radius: 3px; background: ${toColorSwatchBackground(f.color_hex)}; border: 1px solid var(--border); vertical-align: middle; margin-right: 6px;"></span>`
          : ''
        return `
          <tr>
            <td>${colorSwatch}${escapeHtml(f.name || '-')}</td>
            <td>${escapeHtml(f.material || '-')}</td>
            <td>${escapeHtml(vendor)}</td>
          </tr>
        `
      }).join('')
      const more = filaments.length > 20 ? `<tr><td colspan="3" style="text-align: center; color: var(--text-muted); font-style: italic;">... ${t('spoolman.andMore').replace('{count}', String(filaments.length - 20))}</td></tr>` : ''
      return `
        <details style="margin-top: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--accent);">${escapeHtml(t('spoolman.previewFilaments'))} (${filaments.length})</summary>
          <table class="fm-table" style="margin-top: 8px;">
            <thead style="background: var(--bg-soft);"><tr><th>${escapeHtml(t('common.name'))}</th><th>${escapeHtml(t('filaments.type'))}</th><th>${escapeHtml(t('filaments.manufacturer'))}</th></tr></thead>
            <tbody>${rows}${more}</tbody>
          </table>
        </details>
      `
    }

    function renderSpoolPreview(spools: any[]): string {
      if (!spools.length) return ''
      const rows = spools.slice(0, 20).map(s => {
        const filName = s.filament?.name || '-'
        const remaining = s.remaining_weight != null ? `${s.remaining_weight}g` : '-'
        const loc = s.location?.name || '-'
        return `
          <tr>
            <td>#${s.id}</td>
            <td>${escapeHtml(filName)}</td>
            <td>${remaining}</td>
            <td>${escapeHtml(loc)}</td>
          </tr>
        `
      }).join('')
      const more = spools.length > 20 ? `<tr><td colspan="4" style="text-align: center; color: var(--text-muted); font-style: italic;">... ${t('spoolman.andMore').replace('{count}', String(spools.length - 20))}</td></tr>` : ''
      return `
        <details style="margin-top: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--accent);">${escapeHtml(t('spoolman.previewSpools'))} (${spools.length})</summary>
          <table class="fm-table" style="margin-top: 8px;">
            <thead style="background: var(--bg-soft);"><tr><th>ID</th><th>${escapeHtml(t('spools.filament'))}</th><th>${escapeHtml(t('spools.remaining'))}</th><th>${escapeHtml(t('spools.location'))}</th></tr></thead>
            <tbody>${rows}${more}</tbody>
          </table>
        </details>
      `
    }

    // ----------------------------------------------------------------
    //  Step 3: Import
    // ----------------------------------------------------------------

    interface ImportAction {
      button: HTMLButtonElement
      confirmKey: string
      endpoint: string
      pendingKey: string
      completeKey: string
      failedKey: string
      restoreButton: () => void
      renderResult: (result: SpoolmanImportResult) => string
      requestBody: () => Record<string, any>
    }

    interface SpoolmanImportResult {
      manufacturers_created: number
      manufacturers_skipped: number
      locations_created: number
      locations_skipped: number
      colors_created: number
      colors_skipped: number
      color_assignments_repaired?: number
      filaments_created: number
      filaments_skipped: number
      spools_created: number
      spools_skipped: number
      errors: string[]
      warnings: string[]
    }

    async function runImportAction(action: ImportAction) {
      if (importActionRunning) return
      const resultDiv = document.getElementById('import-result')!
      const progressDiv = document.getElementById('import-progress')!
      const progressBar = document.getElementById('import-bar') as HTMLElement
      const statusText = document.getElementById('import-status')!

      if (!(await (window as any).__fmConfirm(t(action.confirmKey), {
        title: action.button.textContent || t(action.pendingKey),
        okLabel: action.button.textContent || t(action.pendingKey),
        isDanger: false,
      }))) return
      if (importActionRunning) return

      importActionRunning = true
      const importButton = document.getElementById('btn-import') as HTMLButtonElement
      const repairButton = document.getElementById('btn-repair-transparency') as HTMLButtonElement
      importButton.disabled = true
      repairButton.disabled = true
      action.button.textContent = t(action.pendingKey)
      progressDiv.style.display = 'block'
      progressBar.style.width = '20%'
      resultDiv.style.display = 'none'

      try {
        progressBar.style.width = '50%'
        statusText.textContent = t(action.pendingKey)

        const response = await fetch(action.endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': getCsrfToken(),
          },
          credentials: 'include',
          body: JSON.stringify(action.requestBody()),
          signal: getAbortSignal(),
        })

        progressBar.style.width = '90%'

        if (!response.ok) {
          const data = await response.json().catch(() => ({}))
          if (data.detail?.code === 'repair_plan_changed') {
            updateTransparencyRepairAction(0)
          }
          throw new Error(data.detail?.message || t(action.failedKey))
        }

        const result = await response.json()
        progressBar.style.width = '100%'
        statusText.textContent = t(action.completeKey)

        resultDiv.style.display = 'block'
        resultDiv.innerHTML = action.renderResult(result)

      } catch (err: unknown) {
        if (isAbortError(err)) return
        const message = err instanceof Error ? err.message : String(err)
        progressDiv.style.display = 'none'
        resultDiv.style.display = 'block'
        resultDiv.innerHTML = `
          <div style="padding: 12px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--error-text); color: var(--error-text);">
            <strong>${escapeHtml(t(action.failedKey))}</strong><br>
            ${escapeHtml(message)}
          </div>
        `
      } finally {
        importActionRunning = false
        importButton.disabled = false
        repairButton.disabled = transparencyRepairCandidates === 0
        action.restoreButton()
      }
    }

    document.getElementById('btn-import')?.addEventListener('click', async () => {
      const button = document.getElementById('btn-import') as HTMLButtonElement
      await runImportAction({
        button,
        confirmKey: 'spoolman.confirmImport',
        endpoint: '/api/v1/admin/system/spoolman-import/execute',
        pendingKey: 'spoolman.importing',
        completeKey: 'spoolman.importComplete',
        failedKey: 'spoolman.importFailed',
        requestBody: () => ({
          url: connectedUrl,
          extra_field_fingerprint: previewData?.extra_field_fingerprint || null,
          extra_field_mode: (document.getElementById('extra-field-mode') as HTMLSelectElement)
            ?.value,
          field_actions: buildImportFieldActions(
            Array.from(document.querySelectorAll<HTMLSelectElement>('.import-field-action')).map(
              (select) => ({
                targetType: select.dataset.target,
                key: select.dataset.key,
                action: select.value as ImportStorageAction,
              }),
            ),
          ),
        }),
        restoreButton: () => {
          button.textContent = t('spoolman.startImport')
        },
        renderResult: (result) => {
          updateTransparencyRepairAction(0)
          return renderImportResult(result)
        },
      })
    })

    document.getElementById('btn-repair-transparency')?.addEventListener('click', async () => {
      const button = document.getElementById('btn-repair-transparency') as HTMLButtonElement
      await runImportAction({
        button,
        confirmKey: 'spoolman.confirmRepairTransparency',
        endpoint: '/api/v1/admin/system/spoolman-import/repair-transparency',
        pendingKey: 'spoolman.repairingTransparency',
        completeKey: 'spoolman.repairTransparencyComplete',
        failedKey: 'spoolman.repairTransparencyFailed',
        requestBody: () => ({
          url: connectedUrl,
          plan_digest: transparencyRepairPlanDigest,
        }),
        restoreButton: () => {
          updateTransparencyRepairAction(
            transparencyRepairCandidates,
            transparencyRepairPlanDigest
          )
        },
        renderResult: (result) => {
          updateTransparencyRepairAction(0)
          return renderTransparencyRepairResult(result)
        },
      })
    })

    function renderTransparencyRepairResult(result: SpoolmanImportResult): string {
      const repaired = Number(result.color_assignments_repaired) || 0
      return `
        <div style="padding: 16px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid var(--accent-2);">
          <h3 style="font-size: 1rem; font-weight: 600; margin: 0 0 8px;">${escapeHtml(t('spoolman.repairTransparencyResults'))}</h3>
          <p style="margin: 0; color: var(--accent-2);">
            ${escapeHtml(
              repaired > 0
                ? t('spoolman.colorAssignmentsRepaired').replace('{count}', String(repaired))
                : t('spoolman.repairTransparencyNoChanges')
            )}
          </p>
          <p style="margin: 6px 0 0; color: var(--text-muted); font-size: 0.85rem;">
            ${escapeHtml(
              t('spoolman.repairTransparencyColors')
                .replace('{created}', String(result.colors_created || 0))
                .replace('{reused}', String(result.colors_skipped || 0))
            )}
          </p>
        </div>
      `
    }

    function renderImportResult(r: SpoolmanImportResult): string {
      const hasErrors = r.errors && r.errors.length > 0
      const hasWarnings = r.warnings && r.warnings.length > 0

      let html = `
        <div style="padding: 16px; border-radius: var(--radius-sm); background: var(--bg-soft); border: 1px solid ${hasErrors ? 'var(--error-text)' : 'var(--accent-2)'};">
          <h3 style="font-size: 1rem; font-weight: 600; margin: 0 0 12px;">${escapeHtml(t('spoolman.importResults'))}</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
            ${resultCard(t('manufacturers.title'), r.manufacturers_created, r.manufacturers_skipped)}
            ${resultCard(t('locations.title'), r.locations_created, r.locations_skipped)}
            ${resultCard(t('filaments.colors'), r.colors_created, r.colors_skipped)}
            ${resultCard(t('filaments.title'), r.filaments_created, r.filaments_skipped)}
            ${resultCard(t('spools.title'), r.spools_created, r.spools_skipped)}
          </div>
      `

      if (hasWarnings) {
        html += `
          <details style="margin-top: 16px;">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--text-muted);">${escapeHtml(t('spoolman.warnings'))} (${r.warnings.length})</summary>
            <ul style="margin-top: 8px; padding-left: 20px; font-size: 0.85rem; color: var(--text-muted);">
              ${r.warnings.map((w: string) => `<li>${escapeHtml(w)}</li>`).join('')}
            </ul>
          </details>
        `
      }

      if (hasErrors) {
        html += `
          <details style="margin-top: 12px;" open>
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--error-text);">${escapeHtml(t('spoolman.errors'))} (${r.errors.length})</summary>
            <ul style="margin-top: 8px; padding-left: 20px; font-size: 0.85rem; color: var(--error-text);">
              ${r.errors.map((e: string) => `<li>${escapeHtml(e)}</li>`).join('')}
            </ul>
          </details>
        `
      }

      html += '</div>'
      return html
    }

    function resultCard(label: string, created: number, skipped: number): string {
      return `
        <div style="background: #fff; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; text-align: center;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">${escapeHtml(label)}</div>
          <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent);">${created}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">${escapeHtml(t('spoolman.created'))}</div>
          ${skipped > 0 ? `<div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">${skipped} ${escapeHtml(t('spoolman.skipped'))}</div>` : ''}
        </div>
      `
    }

    function syncImportModeAvailability(
      data: { extra_field_targets?: unknown },
    ): ImportDefinitionAvailability {
      const definitionAvailability =
        resolveImportDefinitionAvailability(data.extra_field_targets)
      const select = document.getElementById(
        'extra-field-mode',
      ) as HTMLSelectElement
      const availability = resolveImportModeAvailability(
        select.value as ImportStorageMode,
        definitionAvailability.typedDefinitionsAvailable,
      )
      select.querySelectorAll<HTMLOptionElement>(
        'option[value="system"], option[value="local"]',
      ).forEach(option => {
        option.disabled = availability.typedModesDisabled
      })
      select.value = availability.mode
      return definitionAvailability
    }

    function renderExtraFieldPreview(
      fields: any[],
      availability: ImportDefinitionAvailability,
    ): string {
      if (!availability.typedDefinitionsAvailable) {
        return `
          <div class="fm-card" style="margin-top:12px;padding:14px;border-color:var(--accent-3);">
            <strong>${escapeHtml(t('spoolman.extraFields'))}</strong>
            <p style="color:var(--text-muted);font-size:0.85rem;line-height:1.5;margin:8px 0 0;">${escapeHtml(t('spoolman.extraFieldDefinitionsUnavailable'))}</p>
          </div>
        `
      }
      const missingTargetNotice = availability.missingTargets.length
        ? `<p style="color:var(--text-muted);font-size:0.85rem;line-height:1.5;margin:8px 0 0;">${escapeHtml(
            t('spoolman.extraFieldDefinitionsPartial').replace(
              '{targets}',
              availability.missingTargets
                .map(target =>
                  t(target === 'filament' ? 'filaments.title' : 'spools.title')
                )
                .join(', '),
            ),
          )}</p>`
        : ''
      if (!fields.length) {
        return missingTargetNotice
          ? `<div class="fm-card" style="margin-top:12px;padding:14px;border-color:var(--accent-3);"><strong>${escapeHtml(t('spoolman.extraFields'))}</strong>${missingTargetNotice}</div>`
          : ''
      }
      const counts = fields.reduce((all: Record<string, number>, field: any) => {
        all[field.status] = (all[field.status] || 0) + 1
        return all
      }, {})
      return `
        <div class="fm-card" style="margin-top:12px;padding:14px;">
          <strong>${escapeHtml(t('spoolman.extraFields'))}</strong>
          ${missingTargetNotice}
          <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:8px;color:var(--text-muted);font-size:0.85rem;">
            <span>${escapeHtml(t('spoolman.extraFieldsCreate'))}: ${counts.create || 0}</span>
            <span>${escapeHtml(t('spoolman.extraFieldsReuse'))}: ${counts.reuse || 0}</span>
            <span>${escapeHtml(t('spoolman.extraFieldsConflict'))}: ${counts.conflict || 0}</span>
            <span>${escapeHtml(t('spoolman.extraFieldsUnsupported'))}: ${counts.unsupported || 0}</span>
          </div>
          <p style="color:var(--text-muted);font-size:0.82rem;margin:10px 0 6px;">${escapeHtml(t('spoolman.extraFieldOverrideHint'))}</p>
          <div style="overflow-x:auto;">
            <table class="fm-table">
              <thead><tr><th>${escapeHtml(t('spoolman.repairField'))}</th><th>${escapeHtml(t('spoolman.repairType'))}</th><th>${escapeHtml(t('spoolman.extraFieldAction'))}</th></tr></thead>
              <tbody>
                ${fields.map((field: any) => {
                  const supportsTypedImport = ['filament', 'spool'].includes(field.target_type)
                  const systemUnavailable = ['conflict', 'unsupported'].includes(field.status) || Boolean(field.system_conflict)
                  const localUnavailable = ['reuse', 'conflict', 'unsupported'].includes(field.status)
                  const retainedConflict = field.system_conflict
                    ? `<br><span style="color:var(--error-text);font-size:0.78rem;">${escapeHtml(t('spoolman.extraFieldRetainedConflict').replace('{count}', String(field.system_conflict.count)))}</span>`
                    : ''
                  return `<tr>
                    <td><strong>${escapeHtml(field.target_type)}.${escapeHtml(field.key || '')}</strong><br><span style="color:var(--text-muted);font-size:0.78rem;">${escapeHtml(field.label || field.reason || '')}</span>${retainedConflict}</td>
                    <td>${escapeHtml(field.field_type || field.status)}</td>
                    <td>${supportsTypedImport ? `<select class="fm-select import-field-action" data-target="${escapeHtml(field.target_type)}" data-key="${escapeHtml(field.key || '')}">
                      <option value="inherit">${escapeHtml(t('spoolman.extraFieldActionDefault'))}</option>
                      <option value="system"${systemUnavailable ? ' disabled' : ''}>${escapeHtml(t('spoolman.extraFieldActionSystem'))}</option>
                      <option value="local"${localUnavailable ? ' disabled' : ''}>${escapeHtml(t('spoolman.extraFieldActionLocal'))}</option>
                      <option value="preserve">${escapeHtml(t('spoolman.extraFieldActionPreserve'))}</option>
                      <option value="legacy">${escapeHtml(t('spoolman.extraFieldActionLegacy'))}</option>
                    </select>` : escapeHtml(t('spoolman.extraFieldActionPreserve'))}</td>
                  </tr>`
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `
    }

    function repairMode(): string {
      return (document.querySelector<HTMLInputElement>('input[name="repair-mode"]:checked')?.value || 'offline')
    }

    function repairTypeLabel(fieldType: RepairFieldType): string {
      return t(`admin.fieldType_${fieldType}`)
    }

    function repairDetailsValue(
      fieldType: RepairFieldType,
      kind: 'unit' | 'choices' | 'none',
      value: string,
    ): string {
      if (kind !== 'none') return value
      return t('spoolman.repairNotApplicableFor').replace(
        '{type}',
        repairTypeLabel(fieldType),
      )
    }

    function renderRepairConfidence(
      mapping: RepairMapping,
      selectedType: RepairFieldType = mapping.field_type,
    ): string {
      const manual = selectedType !== mapping.field_type
      const confidence = manual ? 'manual' : (mapping.confidence || 'unresolved')
      const tone = repairConfidenceTone(confidence)
      const styles = {
        info: 'color:var(--info-text);border-color:var(--info-border);background:var(--info-bg);',
        success: 'color:var(--success-text);border-color:var(--success-border);background:var(--success-bg);',
        warning: 'color:var(--accent-3);border-color:var(--accent-3);background:var(--bg-soft);',
        error: 'color:var(--error-text);border-color:var(--error-border);background:var(--error-bg);',
        neutral: 'color:var(--text-muted);border-color:var(--border);background:var(--bg-soft);',
      }
      const labelKey = {
        authoritative: 'spoolman.repairConfidenceAuthoritative',
        high: 'spoolman.repairConfidenceHigh',
        medium: 'spoolman.repairConfidenceMedium',
        low: 'spoolman.repairConfidenceLow',
        unresolved: 'spoolman.repairConfidenceUnresolved',
        manual: 'spoolman.repairConfidenceManual',
      }[confidence] || 'spoolman.repairConfidenceUnresolved'
      const reasonKey = {
        source_definition: 'spoolman.repairConfidenceReasonSourceDefinition',
        structured_values: 'spoolman.repairConfidenceReasonStructuredValues',
        date_pattern: 'spoolman.repairConfidenceReasonDatePattern',
        url_pattern: 'spoolman.repairConfidenceReasonUrlPattern',
        majority_match: 'spoolman.repairConfidenceReasonMajorityMatch',
        legacy_text: 'spoolman.repairConfidenceReasonLegacyText',
        legacy_number: 'spoolman.repairConfidenceReasonLegacyNumber',
        legacy_checkbox: 'spoolman.repairConfidenceReasonLegacyCheckbox',
        legacy_scalar: 'spoolman.repairConfidenceReasonLegacyScalar',
        fallback_text: 'spoolman.repairConfidenceReasonFallbackText',
        mixed_text: 'spoolman.repairConfidenceReasonMixedText',
        invalid_key: 'spoolman.repairConfidenceReasonInvalidKey',
        mixed_values: 'spoolman.repairConfidenceReasonMixedValues',
        manual: 'spoolman.repairConfidenceManualHint',
        generic_high: 'spoolman.repairConfidenceReasonGenericHigh',
        generic_medium: 'spoolman.repairConfidenceReasonGenericMedium',
        generic_low: 'spoolman.repairConfidenceReasonGenericLow',
        generic_unresolved: 'spoolman.repairConfidenceReasonGenericUnresolved',
      }[repairConfidenceReason(mapping, selectedType)]
      const ready = Number(mapping.promotable_occurrences || 0)
      const total = Number(mapping.occurrences || 0)
      const coverage = t('spoolman.repairConfidenceValues')
        .replace('{ready}', String(ready))
        .replace('{total}', String(total))
      const asType = t('spoolman.repairConfidenceAs').replace(
        '{type}',
        repairTypeLabel(selectedType),
      )
      return `
        <div class="repair-confidence-content">
          <div class="repair-confidence-rating">
            <strong style="font-size:0.78rem;">${escapeHtml(asType)}</strong>
            <span title="${escapeHtml(t(reasonKey))}" style="display:inline-flex;align-items:center;padding:3px 9px;border:1px solid;border-radius:999px;font-size:0.75rem;font-weight:650;${styles[tone]}">${escapeHtml(t(labelKey))}</span>
          </div>
          <div>
            <div style="color:var(--text-muted);font-size:0.75rem;line-height:1.45;">${escapeHtml(t(reasonKey))}</div>
            ${manual ? '' : `<div style="margin-top:5px;color:var(--text-muted);font-size:0.72rem;line-height:1.3;font-weight:600;">${escapeHtml(coverage)}</div>`}
          </div>
        </div>
      `
    }

    function renderRepairConversionExamples(
      mapping: RepairMapping,
      selectedType: RepairFieldType = mapping.field_type,
      details = '',
    ): string {
      const sourceExamples = mapping.conversion_examples || []
      if (!sourceExamples.length) {
        const samples = ((mapping.samples as unknown[]) || [])
          .map(value => typeof value === 'string' ? value : JSON.stringify(value))
          .join(', ')
        return samples
          ? `<div style="margin-top:8px;color:var(--text-muted);font-size:0.78rem;overflow-wrap:anywhere;"><strong>${escapeHtml(t('spoolman.repairSamples'))}:</strong> ${escapeHtml(samples)}</div>`
          : ''
      }
      const manual = selectedType !== mapping.field_type
      const options = details
        .split(',')
        .map(value => value.trim())
        .filter(Boolean)
      const examples = manual
        ? sourceExamples.flatMap(example => {
            const converted = convertRepairExampleValue(
              example.source,
              mapping,
              selectedType,
              options,
            )
            return converted.ok
              ? [{ source: example.source, converted: converted.value }]
              : []
          })
        : sourceExamples
      const checked = t('spoolman.repairChecked')
      const unchecked = t('spoolman.repairUnchecked')
      const rows = examples.map(example => {
        const source = formatRepairExampleValue(
          example.source,
          selectedType,
          false,
          checked,
          unchecked,
        )
        const converted = formatRepairExampleValue(
          example.converted,
          selectedType,
          true,
          checked,
          unchecked,
        )
        return `
          <div class="repair-example">
            <code title="${escapeHtml(source)}" style="padding:3px 6px;border-radius:6px;background:var(--bg-soft);">${escapeHtml(source)}</code>
            <span aria-hidden="true" style="color:var(--accent);font-weight:700;">→</span>
            <code title="${escapeHtml(converted)}" style="padding:3px 6px;border-radius:6px;background:var(--success-bg);color:var(--success-text);">${escapeHtml(converted)}</code>
          </div>
        `
      }).join('')
      const coverage = (
        manual
          ? t('spoolman.repairManualConversionCoverage')
              .replace('{shown}', String(examples.length))
              .replace('{sampled}', String(sourceExamples.length))
          : t('spoolman.repairConversionCoverage')
              .replace('{shown}', String(examples.length))
              .replace('{count}', String(mapping.promotable_occurrences || 0))
      )
      return `
        <div class="repair-conversion-preview" data-preview-type="${escapeHtml(selectedType)}" style="padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--bg-soft);">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px;">
            <div style="font-size:0.8rem;font-weight:700;">${escapeHtml(t(manual ? 'spoolman.repairManualConversionPreview' : 'spoolman.repairConversionPreview'))}</div>
            <div style="color:var(--text-muted);font-size:0.72rem;">${escapeHtml(coverage)}</div>
          </div>
          ${rows ? `<div class="repair-example-grid" style="font-size:0.76rem;">${rows}</div>` : `<div style="font-size:0.76rem;color:var(--error-text);">${escapeHtml(t('spoolman.repairManualConversionUnavailable'))}</div>`}
        </div>
      `
    }

    function renderRepairPreview(data: any): string {
      const summary = data.summary
      const mappings = data.mappings || []
      const rows = mappings.map((mapping: any, index: number) => {
        const disabled = mapping.status !== 'ready' || mapping.confidence === 'unresolved'
        const options = repairFieldTypes.map(type => `<option value="${type}"${type === mapping.field_type ? ' selected' : ''}>${escapeHtml(repairTypeLabel(type))}</option>`).join('')
        const details = repairDetailsState(mapping, mapping.field_type)
        const detailsValue = repairDetailsValue(
          mapping.field_type,
          details.kind,
          details.value,
        )
        const systemUnavailable = Boolean(mapping.system_conflict)
        const retainedConflict = mapping.system_conflict
          ? `<div style="margin-top:6px;color:var(--error-text);font-size:0.78rem;">${escapeHtml(t('spoolman.extraFieldRetainedConflict').replace('{count}', String(mapping.system_conflict.count)))}</div>`
          : ''
        const noPromotable = mapping.status === 'no_promotable'
          ? `<div style="margin-top:6px;color:var(--text-muted);font-size:0.78rem;">${escapeHtml(t('spoolman.repairNoPromotable'))}</div>`
          : ''
        const actionOptions = `
          <option value="system"${systemUnavailable ? ' disabled' : ''}>${escapeHtml(mapping.existing ? t('spoolman.extraFieldActionReuseSystem') : t('spoolman.extraFieldActionSystem'))}</option>
          <option value="local"${mapping.existing ? ' disabled' : ''}${systemUnavailable && !mapping.existing ? ' selected' : ''}>${escapeHtml(t('spoolman.extraFieldActionLocal'))}</option>
          <option value="preserve">${escapeHtml(t('spoolman.extraFieldActionPreserve'))}</option>`
        return `
          <section class="repair-mapping-card" data-repair-index="${index}">
            <div class="repair-mapping-header">
              <div>
                <label class="repair-field-heading">
                  <input type="checkbox" class="repair-approve"${disabled ? ' disabled' : ''} aria-label="${escapeHtml(t('spoolman.repairApprove'))}" />
                  <span>
                    <span class="repair-section-label">${escapeHtml(t('spoolman.repairApprove'))}</span>
                    <strong class="repair-field-key">${escapeHtml(mapping.target_type)}.${escapeHtml(mapping.key)}</strong>
                  </span>
                </label>
                ${retainedConflict}${noPromotable}
              </div>
              <div>
                <span class="repair-section-label">${escapeHtml(t('spoolman.repairConfidence'))}</span>
                <div class="repair-confidence-host">${renderRepairConfidence(mapping)}</div>
              </div>
            </div>
            <div class="repair-controls">
              <label class="repair-control">
                <span>${escapeHtml(t('admin.displayLabel'))}</span>
                <input class="fm-input repair-label" value="${escapeHtml(mapping.label || mapping.key)}" />
              </label>
              <label class="repair-control">
                <span>${escapeHtml(t('spoolman.repairType'))}</span>
                <select class="fm-select repair-type" data-current-type="${escapeHtml(mapping.field_type)}"${disabled ? ' disabled' : ''}>${options}</select>
              </label>
              <label class="repair-control">
                <span>${escapeHtml(t('spoolman.repairDetails'))}</span>
                <input class="fm-input repair-details" value="${escapeHtml(detailsValue)}" placeholder="${escapeHtml(details.kind === 'choices' ? t('spoolman.repairChoicesPlaceholder') : '')}"${disabled || details.disabled ? ' disabled' : ''}${details.required ? ' required' : ''} />
              </label>
              <label class="repair-control">
                <span>${escapeHtml(t('spoolman.extraFieldAction'))}</span>
                <select class="fm-select repair-action"${disabled ? ' disabled' : ''}>${actionOptions}</select>
              </label>
            </div>
            <div class="repair-conversion-host">${renderRepairConversionExamples(mapping)}</div>
          </section>
        `
      }).join('')
      return `
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px;">
          ${repairMetric(t('spoolman.repairRecords'), summary.records_scanned)}
          ${repairMetric(t('spoolman.repairFields'), summary.fields_found)}
          ${repairMetric(t('spoolman.repairPromotable'), summary.promotable)}
          ${repairMetric(t('spoolman.repairCollisions'), summary.collisions)}
          ${repairMetric(t('spoolman.repairUnresolved'), summary.unresolved + summary.invalid)}
        </div>
        ${rows ? `<div class="repair-mapping-list">${rows}</div>` : ''}
      `
    }

    function repairMetric(label: string, value: number): string {
      return `<div style="padding:10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-soft);"><div style="font-size:0.78rem;color:var(--text-muted);">${escapeHtml(label)}</div><div style="font-size:1.25rem;font-weight:700;">${value}</div></div>`
    }

    function updateRepairEvidence(
      row: HTMLElement,
      source: RepairMapping,
    ): void {
      const selectedType = (
        row.querySelector<HTMLSelectElement>('.repair-type')?.value ||
        source.field_type
      ) as RepairFieldType
      const details =
        row.querySelector<HTMLInputElement>('.repair-details')?.value || ''
      const conversionHost = row.querySelector<HTMLElement>(
        '.repair-conversion-host',
      )
      const confidenceHost = row.querySelector<HTMLElement>('.repair-confidence-host')
      if (conversionHost) {
        conversionHost.innerHTML = renderRepairConversionExamples(
          source,
          selectedType,
          details,
        )
      }
      if (confidenceHost) {
        confidenceHost.innerHTML = renderRepairConfidence(source, selectedType)
      }
    }

    document.getElementById('btn-repair-preview')?.addEventListener('click', async () => {
      const button = document.getElementById('btn-repair-preview') as HTMLButtonElement
      const result = document.getElementById('repair-preview-result')!
      const mode = repairMode()
      const url = (document.getElementById('spoolman-url') as HTMLInputElement).value.trim()
      if (mode === 'server' && !url) {
        result.style.display = 'block'
        result.innerHTML = `<div class="fm-alert-error">${escapeHtml(t('spoolman.urlRequired'))}</div>`
        return
      }
      button.disabled = true
      button.textContent = t('spoolman.repairLoading')
      try {
        const response = await fetch('/api/v1/admin/system/spoolman-import/repair/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({ mode, url: mode === 'server' ? url : null }),
          signal: getAbortSignal(),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.detail?.message || t('spoolman.repairFailed'))
        repairPreview = data
        result.style.display = 'block'
        result.innerHTML = renderRepairPreview(data)
        result.querySelectorAll<HTMLSelectElement>('.repair-type').forEach(select => {
          select.addEventListener('change', () => {
            const row = select.closest<HTMLElement>('[data-repair-index]')
            if (!row || !repairPreview) return
            const source = repairPreview.mappings[Number(row.dataset.repairIndex)] as RepairMapping
            const detailsInput = row.querySelector<HTMLInputElement>('.repair-details')
            if (!detailsInput) return
            const previousType = select.dataset.currentType as RepairFieldType
            const nextType = select.value as RepairFieldType
            const details = repairDetailsState(
              source,
              nextType,
              previousType,
              detailsInput.value,
            )
            select.dataset.currentType = nextType
            detailsInput.value = repairDetailsValue(
              nextType,
              details.kind,
              details.value,
            )
            detailsInput.disabled = details.disabled
            detailsInput.required = details.required
            detailsInput.placeholder =
              details.kind === 'choices' ? t('spoolman.repairChoicesPlaceholder') : ''
            updateRepairEvidence(row, source)
          })
        })
        result.querySelectorAll<HTMLInputElement>('.repair-details').forEach(input => {
          input.addEventListener('input', () => {
            const row = input.closest<HTMLElement>('[data-repair-index]')
            if (!row || !repairPreview) return
            const source = repairPreview.mappings[
              Number(row.dataset.repairIndex)
            ] as RepairMapping
            updateRepairEvidence(row, source)
          })
        })
        document.getElementById('repair-actions')!.style.display = data.mappings?.length ? 'block' : 'none'
        document.getElementById('repair-result')!.style.display = 'none'
      } catch (error: any) {
        if (isAbortError(error)) return
        result.style.display = 'block'
        result.innerHTML = `<div class="fm-alert-error">${escapeHtml(error.message)}</div>`
      } finally {
        button.disabled = false
        button.textContent = t('spoolman.repairPreview')
      }
    })

    document.getElementById('btn-repair-execute')?.addEventListener('click', async () => {
      if (!repairPreview) return
      let approved: RepairMapping[]
      try {
        approved = Array.from(document.querySelectorAll<HTMLElement>('[data-repair-index]')).flatMap(row => {
          const checkbox = row.querySelector<HTMLInputElement>('.repair-approve')
          if (!checkbox?.checked) return []
          const source = repairPreview.mappings[Number(row.dataset.repairIndex)] as RepairMapping
          return [
            buildRepairMappingPayload(source, {
              label: row.querySelector<HTMLInputElement>('.repair-label')?.value || source.key,
              fieldType: (row.querySelector<HTMLSelectElement>('.repair-type')?.value || source.field_type) as RepairFieldType,
              details: row.querySelector<HTMLInputElement>('.repair-details')?.value || '',
              action: (row.querySelector<HTMLSelectElement>('.repair-action')?.value || 'system') as RepairStorageAction,
            }),
          ]
        })
      } catch (error) {
        if (error instanceof RepairMappingValidationError) {
          await (window as any).__fmAlert(t('spoolman.repairChoicesRequired'))
          return
        }
        throw error
      }
      if (!approved.length) {
        await (window as any).__fmAlert(t('spoolman.repairSelectOne'))
        return
      }
      if (!(await (window as any).__fmConfirm(t('spoolman.repairConfirm'), { title: t('spoolman.repairTitle'), okLabel: t('spoolman.repairApply'), isDanger: false }))) return

      const button = document.getElementById('btn-repair-execute') as HTMLButtonElement
      const output = document.getElementById('repair-result')!
      const mode = repairMode()
      const url = (document.getElementById('spoolman-url') as HTMLInputElement).value.trim()
      button.disabled = true
      try {
        const response = await fetch('/api/v1/admin/system/spoolman-import/repair/execute', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
          credentials: 'include',
          body: JSON.stringify({
            mode,
            url: mode === 'server' ? url : null,
            preview_fingerprint: repairPreview.preview_fingerprint,
            approved_mappings: approved,
          }),
          signal: getAbortSignal(),
        })
        const data = await response.json().catch(() => ({}))
        if (!response.ok) throw new Error(data.detail?.message || t('spoolman.repairFailed'))
        output.style.display = 'block'
        output.innerHTML = `
          <div style="padding:14px;border:1px solid var(--accent-2);border-radius:var(--radius-sm);background:var(--bg-soft);">
            <strong>${escapeHtml(t('spoolman.repairComplete'))}</strong>
            <div style="display:flex;gap:18px;flex-wrap:wrap;margin-top:8px;font-size:0.88rem;">
              <span>${escapeHtml(t('spoolman.repairDefinitionsCreated'))}: ${data.definitions_created}</span>
              <span>${escapeHtml(t('spoolman.repairLocalDefinitionsCreated'))}: ${data.local_definitions_created || 0}</span>
              <span>${escapeHtml(t('spoolman.repairRecordsUpdated'))}: ${data.records_updated}</span>
              <span>${escapeHtml(t('spoolman.repairValuesPromoted'))}: ${data.values_promoted}</span>
              <span>${escapeHtml(t('spoolman.repairValuesPreserved'))}: ${data.values_preserved}</span>
            </div>
            <button id="btn-download-repair" class="fm-btn fm-btn-outline" style="margin-top:12px;">${escapeHtml(t('spoolman.repairDownload'))}</button>
          </div>`
        document.getElementById('btn-download-repair')?.addEventListener('click', () => {
          const blob = new Blob([JSON.stringify({ mappings: approved, result: data }, null, 2)], { type: 'application/json' })
          const link = document.createElement('a')
          link.href = URL.createObjectURL(blob)
          link.download = 'spoolman-import-repair-report.json'
          link.click()
          URL.revokeObjectURL(link.href)
        })
        document.getElementById('repair-actions')!.style.display = 'none'
      } catch (error: any) {
        if (isAbortError(error)) return
        output.style.display = 'block'
        output.innerHTML = `<div class="fm-alert-error">${escapeHtml(error.message)}</div>`
      } finally {
        button.disabled = false
      }
    })
  </script>
</Layout>
