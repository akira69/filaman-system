---
import Layout from '../../layouts/Layout.astro'

export function getStaticPaths() {
  return [{ params: { slug: 'detail' } }]
}
---

<Layout title="FilaMan - Plugin" noPadding>
  {/* iframe src is built client-side so we can read theme + locale from
      localStorage / the live data-theme attribute set by Layout.astro */}
  <iframe
    id="plugin-iframe"
    title="Plugin"
    style="flex: 1; width: 100%; border: none; display: block;"
  ></iframe>

  <script>
    const pluginKey = window.location.pathname.split('/').filter(Boolean)[1] || ''
    const iframe = document.getElementById('plugin-iframe') as HTMLIFrameElement
    const pageTitle = decodeURIComponent(pluginKey)
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase())
    document.title = `FilaMan - ${pageTitle}`
    iframe.title = pageTitle

    function buildSrc() {
      // Map FilaMan theme to the two values the SPA understands.
      // "brand" (Default) is a dark green palette — treat as dark.
      const rawTheme = document.documentElement.getAttribute('data-theme') || 'brand'
      const swaTheme = rawTheme === 'light' ? 'light' : 'dark'
      const lang = localStorage.getItem('lang') || 'en'

      const base = `/plugins/${pluginKey}/`
      const params = new URLSearchParams({
        filaman_hosted: '1',
        filaman_hosted_config: `/plugins/${pluginKey}/hosted-config`,
        filaman_theme: swaTheme,
        spoolman_locale: lang,
      })
      return `${base}?${params.toString()}`
    }

    iframe.src = buildSrc()

    // Re-build src when FilaMan theme changes (data-theme attribute on <html>)
    // so toggling theme while on the page causes the SPA to reload with the
    // correct theme rather than staying on the wrong one.
    const observer = new MutationObserver(() => {
      const newSrc = buildSrc()
      if (iframe.src !== window.location.origin + newSrc) {
        iframe.src = newSrc
      }
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'lang'],
    })
  </script>
</Layout>
